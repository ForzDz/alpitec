---
import '../styles/global.css';

/**
 * Coquille HTML commune à toutes les pages.
 *
 * Ne contient aucun élément visuel : ni en-tête, ni pied de page, ni texte.
 * Tout le contenu affiché vient de src/content/ via les pages qui l'utilisent.
 *
 * Le slot nommé « schema » reçoit le JSON-LD propre à chaque page
 * (LocalBusiness sur l'accueil, Service + FAQPage sur les pages services).
 */

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = '/og/alpitec.jpg',
  noindex = false,
} = Astro.props;

// URL canonique : dérivée de l'URL courante, surchargeable par la page.
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/*
      Montserrat seule est préchargée : elle porte le H1, donc le LCP.
      Switzer se charge normalement — le corps de texte apparaît quelques
      dizaines de millisecondes plus tard, ce que `font-display: swap` couvre.
      Précharger les deux ferait entrer 45 Ko en concurrence sur le chemin
      critique au lieu de 17.
    */}
    <link
      rel="preload"
      href="/fonts/montserrat-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ALPITEC" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    {/* Twitter/X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* JSON-LD fourni par la page. */}
    <slot name="schema" />

    {/* Posé avant le premier rendu : sans JS, aucun élément n'est masqué. */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.setAttribute('data-reveal-actif', '');
      }
    </script>
  </head>

  <body>
    <slot />

    <script>
      /**
       * MOUVEMENT — apparition au défilement et parallax.
       *
       * Tout est gouverné par `data-reveal-actif`, posé sur <html> avant le
       * premier rendu uniquement si le visiteur n'a pas demandé moins de
       * mouvement. Sans cet attribut, le CSS n'a jamais rien masqué et ce
       * script ne fait rien : la page est simplement là, ce qui est son état
       * final de toute façon.
       *
       * Aucune bibliothèque. Un observateur pour les apparitions, un second
       * pour le parallax, et UNE boucle d'animation partagée qui ne tourne
       * que tant qu'une photo concernée est à l'écran.
       */
      const actif = document.documentElement.hasAttribute('data-reveal-actif');
      const isolees = document.querySelectorAll('[data-reveal]');
      const groupes = document.querySelectorAll('[data-reveal-groupe]');

      if (!actif) {
        // Mouvement réduit : rien à faire.
      } else if (!('IntersectionObserver' in window)) {
        // Sans observateur, on montre tout plutôt que de laisser du vide.
        for (const el of isolees) el.classList.add('est-visible');
        for (const g of groupes) {
          for (const enfant of g.children) enfant.classList.add('est-visible');
        }
      } else {
        /*
         * Le retard de cascade est posé une fois, à l'observation, sur les
         * enfants directs du groupe. Le calculer ici plutôt qu'en CSS évite
         * autant de règles `:nth-child` qu'il y a de cartes, et le pas reste
         * modifiable depuis le seul `--pas-stagger` de global.css.
         */
        const pas =
          parseFloat(
            getComputedStyle(document.documentElement).getPropertyValue('--pas-stagger'),
          ) || 80;

        // Passe à vrai à la première révélation : l'observateur a fait son
        // travail, le filet de sécurité n'a plus lieu d'être.
        let revelationConstatee = false;

        /*
         * DÉCOUPAGE EN LIGNES DES GRANDS TITRES.
         *
         * Aucun sélecteur CSS ne sait désigner une ligne de texte : il faut la
         * matérialiser. Chaque mot est enveloppé, on relève son `offsetTop`,
         * et les mots qui partagent la même hauteur forment une ligne, elle
         * aussi enveloppée — d'où le masque et le glissement.
         *
         * Le découpage a lieu APRÈS la mise en page, donc `text-wrap: balance`
         * a déjà décidé des coupes : on ne fait que les constater.
         *
         * Le HTML d'origine est conservé pour pouvoir tout refaire au
         * redimensionnement, où les coupes changent.
         */
        const titres = document.querySelectorAll('[data-reveal="titre"]');

        const decouper = (titre) => {
          if (titre.dataset.htmlOrigine === undefined) {
            titre.dataset.htmlOrigine = titre.innerHTML;
          } else {
            titre.innerHTML = titre.dataset.htmlOrigine;
          }

          // Un mot = un span. On garde la classe du parent pour ne pas perdre
          // l'accent orange que <TitreSection> pose sur le dernier mot.
          const mots = [];
          const parcourir = (noeud, classe) => {
            for (const enfant of [...noeud.childNodes]) {
              if (enfant.nodeType === 3) {
                const morceaux = enfant.textContent.split(/(\s+)/);
                const remplacement = document.createDocumentFragment();
                for (const morceau of morceaux) {
                  if (!morceau) continue;
                  if (/^\s+$/.test(morceau)) {
                    remplacement.appendChild(document.createTextNode(morceau));
                  } else {
                    const span = document.createElement('span');
                    span.textContent = morceau;
                    span.style.display = 'inline-block';
                    if (classe) span.className = classe;
                    mots.push(span);
                    remplacement.appendChild(span);
                  }
                }
                enfant.replaceWith(remplacement);
              } else if (enfant.nodeType === 1) {
                parcourir(enfant, enfant.className || classe);
                // Le span d'origine n'a plus de raison d'être : ses mots
                // portent désormais sa classe eux-mêmes.
                enfant.replaceWith(...enfant.childNodes);
              }
            }
          };
          parcourir(titre, '');

          if (mots.length === 0) return false;

          // Regroupement par hauteur : une même `offsetTop` = une même ligne.
          const lignes = [];
          let hauteurCourante = null;
          for (const mot of mots) {
            const haut = mot.offsetTop;
            if (hauteurCourante === null || Math.abs(haut - hauteurCourante) > 4) {
              hauteurCourante = haut;
              lignes.push([]);
            }
            lignes[lignes.length - 1].push(mot);
          }

          // Reconstruction : un bloc masqué par ligne.
          const fragment = document.createDocumentFragment();
          lignes.forEach((motsDeLigne, i) => {
            const ligne = document.createElement('span');
            ligne.className = 'ligne';
            const interieur = document.createElement('span');
            interieur.className = 'ligne-interieur';
            interieur.style.setProperty('--retard', `${i * pas}ms`);
            motsDeLigne.forEach((mot, j) => {
              if (j > 0) interieur.appendChild(document.createTextNode(' '));
              mot.style.display = '';
              interieur.appendChild(mot);
            });
            ligne.appendChild(interieur);
            fragment.appendChild(ligne);
            /*
             * Une espace entre deux lignes. Les blocs se suffisent à l'écran,
             * mais `textContent` les recollerait — « spécialistesdes travaux » —
             * et c'est ce texte-là que lisent les extracteurs et une partie des
             * outils d'accessibilité. Sur un H1, on ne prend pas le risque.
             */
            if (i < lignes.length - 1) {
              fragment.appendChild(document.createTextNode(' '));
            }
          });

          titre.replaceChildren(fragment);
          titre.classList.add('titre-masque');
          return true;
        };

        for (const titre of titres) decouper(titre);

        /*
         * Au redimensionnement, les coupes changent : on redécoupe. Les titres
         * déjà révélés le restent — on remet la classe tout de suite, sinon ils
         * repartiraient de sous la ligne en plein milieu de lecture.
         */
        let redecoupage;
        addEventListener(
          'resize',
          () => {
            clearTimeout(redecoupage);
            redecoupage = setTimeout(() => {
              for (const titre of titres) {
                const dejaVu = titre.classList.contains('est-visible');
                if (decouper(titre) && dejaVu) titre.classList.add('est-visible');
              }
            }, 200);
          },
          { passive: true },
        );

        const revele = new IntersectionObserver(
          (entrees) => {
            for (const entree of entrees) {
              if (!entree.isIntersecting) continue;
              const el = entree.target;
              revele.unobserve(el);
              revelationConstatee = true;

              if (el.hasAttribute('data-reveal-groupe')) {
                [...el.children].forEach((enfant, i) => {
                  enfant.style.setProperty('--retard', `${i * pas}ms`);
                  enfant.classList.add('est-visible');
                });
              } else {
                el.classList.add('est-visible');
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );

        for (const el of isolees) revele.observe(el);
        for (const g of groupes) revele.observe(g);

        /*
         * FILET DE SÉCURITÉ.
         *
         * L'apparition masque le contenu en attendant l'observateur. Si celui-ci
         * ne rendait jamais la main — onglet jamais composité, moteur exotique,
         * extension qui neutralise l'API — la page resterait blanche, et ce
         * serait un défaut autrement plus grave que l'absence d'animation.
         *
         * Une seconde après le chargement, on vérifie donc qu'aucun élément
         * présent à l'écran n'est encore masqué. Si c'est le cas, on montre
         * tout et on cesse d'observer. Quand l'observateur fonctionne — le cas
         * normal — ce contrôle ne trouve rien et ne coûte qu'un passage.
         */
        const toutMontrer = () => {
          for (const el of isolees) el.classList.add('est-visible');
          for (const g of groupes) {
            for (const enfant of g.children) enfant.classList.add('est-visible');
          }
          revele.disconnect();
        };

        /*
         * Le filet s'arme tant qu'aucune révélation n'a eu lieu, et se désarme
         * définitivement à la première — celle-ci prouvant que l'observateur
         * fonctionne. Un contrôle unique ne suffirait pas : sur l'accueil, le
         * hero ne porte aucune apparition, donc rien n'est « bloqué » tant que
         * le visiteur n'a pas défilé, et un premier défilement parasite
         * consommerait le seul contrôle disponible.
         */
        let attente = null;
        const verifier = () => {
          if (revelationConstatee || attente) return;
          attente = setTimeout(() => {
            attente = null;
            if (revelationConstatee) return;
            const h = window.innerHeight;
            const bloque = [...isolees, ...groupes].some((el) => {
              const r = el.getBoundingClientRect();
              if (r.top >= h || r.bottom <= 0) return false;
              return el.hasAttribute('data-reveal-groupe')
                ? [...el.children].some((c) => !c.classList.contains('est-visible'))
                : !el.classList.contains('est-visible');
            });
            if (bloque) toutMontrer();
          }, 900);
        };

        if (document.readyState === 'complete') verifier();
        else addEventListener('load', verifier, { once: true });
        addEventListener('scroll', verifier, { passive: true });

        /* ------------------------- Ligne de progression des étapes (mobile) */
        /*
         * Le rail se remplit selon la position d'une ligne de référence fixée
         * aux trois cinquièmes de la fenêtre : une étape s'allume quand elle
         * arrive à cette hauteur, pas quand elle effleure le bas de l'écran.
         *
         * Tout est calculé dans une boucle rAF partagée, alimentée par un
         * observateur : hors écran, rien ne tourne. On n'écrit que deux
         * propriétés composables — une variable de transform et une classe.
         */
        const blocsEtapes = document.querySelectorAll('[data-etapes]');

        if (blocsEtapes.length > 0 && !matchMedia('(width >= 48rem)').matches) {
          const actifs = new Set();
          let planifieEtapes = false;

          const majEtapes = () => {
            planifieEtapes = false;
            const reference = window.innerHeight * 0.6;

            for (const bloc of actifs) {
              const rail = bloc.querySelector('[data-rail]');
              const points = bloc.querySelectorAll('.etape-point');
              if (!rail || points.length === 0) continue;

              const r = rail.getBoundingClientRect();
              if (r.height === 0) continue;

              const avance = Math.max(0, Math.min(1, (reference - r.top) / r.height));
              rail.style.setProperty('--progression', avance.toFixed(3));

              for (const point of points) {
                const p = point.getBoundingClientRect();
                const centre = p.top + p.height / 2;
                point.classList.toggle('atteint', centre <= reference);
              }
            }
          };

          const demanderEtapes = () => {
            if (planifieEtapes) return;
            planifieEtapes = true;
            requestAnimationFrame(majEtapes);
          };

          const suiviEtapes = new IntersectionObserver(
            (entrees) => {
              for (const entree of entrees) {
                if (entree.isIntersecting) actifs.add(entree.target);
                else actifs.delete(entree.target);
              }
              if (actifs.size > 0) demanderEtapes();
            },
            { rootMargin: '20% 0px' },
          );

          for (const bloc of blocsEtapes) {
            // La classe n'est posée qu'ici : sans script, l'état par défaut du
            // CSS reste le schéma complet, jamais une ligne grise inerte.
            bloc.classList.add('etapes-animees');
            suiviEtapes.observe(bloc);
          }

          addEventListener('scroll', () => actifs.size > 0 && demanderEtapes(), {
            passive: true,
          });
          addEventListener('resize', demanderEtapes, { passive: true });
          demanderEtapes();
        }

        /* ------------------------------------------------------ Parallax */
        const photos = document.querySelectorAll('[data-parallax]');

        if (photos.length > 0) {
          // Amplitude en pourcentage de la hauteur du cadre. L'image étant
          // tirée à 115 %, 7,5 % de chaque côté ne découvre jamais de bord.
          const AMPLITUDE = 0.075;
          const visibles = new Set();
          let planifie = false;

          const placer = () => {
            planifie = false;
            const h = window.innerHeight;
            for (const cadre of visibles) {
              const image = cadre.querySelector('img, video');
              if (!image) continue;
              const r = cadre.getBoundingClientRect();
              // -1 quand le cadre sort par le haut, +1 quand il entre par le
              // bas ; 0 quand il est centré.
              const avance = (r.top + r.height / 2 - h / 2) / (h / 2 + r.height / 2);
              const y = Math.max(-1, Math.min(1, avance)) * AMPLITUDE * r.height;
              image.style.transform = `translate3d(0, ${y.toFixed(1)}px, 0)`;
            }
          };

          const demander = () => {
            if (planifie) return;
            planifie = true;
            requestAnimationFrame(placer);
          };

          const suivi = new IntersectionObserver(
            (entrees) => {
              for (const entree of entrees) {
                if (entree.isIntersecting) visibles.add(entree.target);
                else visibles.delete(entree.target);
              }
              // La boucle ne tourne que s'il reste quelque chose à bouger.
              if (visibles.size > 0) demander();
            },
            { rootMargin: '10% 0px' },
          );

          for (const cadre of photos) {
            cadre.classList.add('parallax');
            suivi.observe(cadre);
          }

          addEventListener('scroll', () => visibles.size > 0 && demander(), {
            passive: true,
          });
          addEventListener('resize', demander, { passive: true });
          demander();
        }
      }
    </script>
  </body>
</html>
