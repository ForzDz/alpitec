---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import ContactSection from '../../components/ContactSection.astro';
import { getServices, getServicePhotos, serviceHref } from '../../lib/content.js';

const services = await getServices();
const accueil = await getEntry('home', 'accueil');
const cartesAccueil = accueil.data.services;

const titre = 'Nos 9 services cordistes — Paris & Île-de-France | ALPITEC';
const description =
  "Ravalement, couverture, nettoyage de vitres, maçonnerie, filets, anti-pigeons, chéneaux, dévégétalisation, points d'ancrage : les 9 prestations cordistes d'ALPITEC.";

const filAriane = [
  { label: 'Accueil', href: '/' },
  { label: 'Nos services', href: '/services' },
];

const cartes = services.map((service) => {
  const accroche = cartesAccueil.cards.find((c) => c.slug === service.data.slug);
  const legendes = service.data.sections.find((s) => s.type === 'realisations')?.photos ?? [];
  const [photo] = getServicePhotos(service.data.slug, legendes, 1);

  return {
    slug: service.data.slug,
    ordre: service.data.ordre,
    title: service.data.title,
    shortLabel: service.data.shortLabel,
    text: accroche?.text,
    image: photo?.alt ? { src: photo.src, alt: photo.alt } : undefined,
  };
});

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${new URL('/services', Astro.site).href}#page`,
      name: cartesAccueil.title,
      description,
      url: new URL('/services', Astro.site).href,
    },
    {
      '@type': 'ItemList',
      '@id': `${new URL('/services', Astro.site).href}#liste`,
      numberOfItems: services.length,
      itemListElement: services.map((service, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: service.data.title,
        url: new URL(serviceHref(service.data.slug), Astro.site).href,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: filAriane.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.label,
        item: new URL(item.href, Astro.site).href,
      })),
    },
  ],
};
---

<Base title={titre} description={description} canonical="/services">
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  <Header transparent />

  <main id="contenu">

    {/* ─── HERO ─── */}
    <section class="si-hero -mt-16 pt-16 sm:-mt-20 sm:pt-20">
      <div class="si-hero__bg" aria-hidden="true">
        <div class="si-hero__blob si-hero__blob--1"></div>
        <div class="si-hero__blob si-hero__blob--2"></div>
        <div class="si-hero__grid"></div>
      </div>

      <div class="si-hero__inner">
        <Breadcrumb items={filAriane} ton="clair" class="mb-10 sm:mb-14" />

        <div class="si-hero__pill">
          <span class="si-hero__pill-dot" aria-hidden="true"></span>
          <span>Paris & Île-de-France</span>
        </div>

        <h1 class="si-hero__h1">
          {cartesAccueil.title}
        </h1>

        <p class="si-hero__intro">{cartesAccueil.intro}</p>

        {/* Stats horizontales */}
        <div class="si-hero__stats" aria-hidden="true">
          {[
            { val: '9', lbl: 'Prestations cordistes' },
            { val: '2009', lbl: "Depuis" },
            { val: '24h', lbl: 'Réponse devis' },
            { val: '10 ans', lbl: 'Garantie décennale' },
          ].map(s => (
            <div class="si-hero__stat">
              <span class="si-hero__stat-val">{s.val}</span>
              <span class="si-hero__stat-lbl">{s.lbl}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ─── GRILLE SERVICES ─── */}
    <section class="si-grid-section" aria-label="Liste des services">
      <div class="si-grid-section__inner">

        <div class="si-grid-section__eyebrow">
          <span class="si-grid-section__eyebrow-line" aria-hidden="true"></span>
          Toutes nos prestations
        </div>

        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {cartes.map((carte) => (
            <li class="flex">
              <ServiceCard
                service={carte}
                image={carte.image}
                linkLabel={cartesAccueil.linkLabel}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ─── WHY CORDISTES SECTION ─── */}
    <section class="si-why">
      <div class="si-why__inner">
        <div class="si-why__eyebrow">
          <span class="si-why__eyebrow-line" aria-hidden="true"></span>
          Pourquoi les cordistes ?
        </div>

        <h2 class="si-why__title">
          Sans échafaudage,<br/><span class="si-why__title-accent">sans compromis</span>
        </h2>

        <div class="si-why__grid">
          {[
            {
              icon: '⚡',
              title: 'Intervention rapide',
              text: 'Aucune autorisation de voirie, aucun montage — nos cordistes déploient leur matériel en moins d\'une heure.',
            },
            {
              icon: '💰',
              title: 'Coût maîtrisé',
              text: 'L\'accès sur cordes coûte 3 à 5× moins qu\'un échafaudage complet, pour un résultat identique ou supérieur.',
            },
            {
              icon: '🎯',
              title: 'Précision au centimètre',
              text: 'Le cordiste travaille au contact direct de la surface — ce qui lui permet d\'intervenir là où aucune nacelle ne peut aller.',
            },
            {
              icon: '🛡️',
              title: 'Certifiés & assurés',
              text: 'CQP, IRATA, CATSC, CACES — nos équipes sont qualifiées selon les standards les plus élevés du secteur.',
            },
          ].map(item => (
            <div class="si-why__card">
              <div class="si-why__card-icon" aria-hidden="true">{item.icon}</div>
              <h3 class="si-why__card-title">{item.title}</h3>
              <p class="si-why__card-text">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CtaBand
      title={accueil.data.contact.title}
      text={accueil.data.contact.text}
      buttons={[{ label: 'Demander mon devis gratuit', action: 'devis' }, { label: 'Nous appeler', action: 'tel' }]}
    />

    <ContactSection id="devis" />
  </main>

  <Footer />
</Base>

<style>
/* ─── HERO ─────────────────────────────────────────────────────────────────── */
.si-hero {
  position: relative;
  overflow: hidden;
  background: var(--color-navy-profond);
  padding-bottom: 5rem;
}

.si-hero__bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.si-hero__blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
}

.si-hero__blob--1 {
  width: 700px;
  height: 700px;
  right: -200px;
  top: -200px;
  background: radial-gradient(circle, color-mix(in srgb, var(--color-orange) 10%, transparent) 0%, transparent 70%);
}

.si-hero__blob--2 {
  width: 400px;
  height: 400px;
  left: -100px;
  bottom: -100px;
  background: radial-gradient(circle, color-mix(in srgb, var(--color-navy-clair) 15%, transparent) 0%, transparent 70%);
}

.si-hero__grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(color-mix(in srgb, var(--color-blanc) 2.5%, transparent) 1px, transparent 1px),
    linear-gradient(90deg, color-mix(in srgb, var(--color-blanc) 2.5%, transparent) 1px, transparent 1px);
  background-size: 60px 60px;
}

.si-hero__inner {
  position: relative;
  max-width: 72rem;
  margin: 0 auto;
  padding: 1.5rem 1.25rem 0;
}

@media (min-width: 640px) {
  .si-hero__inner {
    padding: 2rem 2rem 0;
  }
}

.si-hero__pill {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.375rem 0.875rem;
  border-radius: 9999px;
  background: color-mix(in srgb, var(--color-blanc) 6%, transparent);
  border: 1px solid color-mix(in srgb, var(--color-blanc) 12%, transparent);
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 600;
  letter-spacing: var(--text-etiquette--letter-spacing);
  text-transform: uppercase;
  color: color-mix(in srgb, var(--color-blanc) 70%, transparent);
  margin-bottom: 1.5rem;
}

.si-hero__pill-dot {
  display: block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--color-orange);
  box-shadow: 0 0 6px var(--color-orange);
  animation: pulse-dot 2.4s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.85); }
}

.si-hero__h1 {
  font-family: var(--font-display);
  font-size: clamp(2.25rem, 5.5vw, 4.25rem);
  font-weight: 800;
  letter-spacing: -0.025em;
  line-height: 1.0;
  color: var(--color-blanc);
  max-width: 18ch;
  text-wrap: balance;
  margin-bottom: 1.5rem;
}

.si-hero__intro {
  font-family: var(--font-sans);
  font-size: var(--text-corps-large);
  font-weight: 300;
  line-height: 1.7;
  color: color-mix(in srgb, var(--color-blanc) 70%, transparent);
  max-width: 58ch;
  text-wrap: pretty;
  margin-bottom: 3rem;
}

/* Stats bar */
.si-hero__stats {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  border-top: 1px solid color-mix(in srgb, var(--color-blanc) 8%, transparent);
  padding-top: 2rem;
}

.si-hero__stat {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 0 2rem 1rem 0;
  border-right: 1px solid color-mix(in srgb, var(--color-blanc) 8%, transparent);
  margin-right: 2rem;
}

.si-hero__stat:last-child {
  border-right: none;
}

.si-hero__stat-val {
  font-family: var(--font-display);
  font-size: var(--text-sous-titre);
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--color-orange);
  line-height: 1;
}

.si-hero__stat-lbl {
  font-family: var(--font-sans);
  font-size: var(--text-etiquette);
  font-weight: 400;
  color: color-mix(in srgb, var(--color-blanc) 70%, transparent);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

/* ─── GRID SECTION ──────────────────────────────────────────────────────────── */
.si-grid-section {
  background: var(--color-gris);
  padding: 5rem 0;
}

.si-grid-section__inner {
  max-width: 72rem;
  margin: 0 auto;
  padding: 0 1.25rem;
}

@media (min-width: 640px) {
  .si-grid-section__inner {
    padding: 0 2rem;
  }
}

.si-grid-section__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 700;
  letter-spacing: var(--text-etiquette--letter-spacing);
  text-transform: uppercase;
  color: var(--color-navy);
  margin-bottom: 2.5rem;
}

.si-grid-section__eyebrow-line {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--color-orange);
  border-radius: 1px;
}

/* Grille asymétrique : 1ère carte en vedette, toutes les autres normales */
.si-grid {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 1rem;
  grid-template-columns: 1fr;
}

@media (min-width: 640px) {
  .si-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .si-grid {
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto;
  }
  /* Première carte : grande, sur 2 colonnes et 2 rangées */
  .si-grid__item--featured {
    grid-column: span 2;
    grid-row: span 2;
  }
}

.si-grid__item {
  display: flex;
}

/* ─── WHY SECTION ───────────────────────────────────────────────────────────── */
.si-why {
  background: var(--color-blanc);
  padding: 5rem 0;
}

.si-why__inner {
  max-width: 72rem;
  margin: 0 auto;
  padding: 0 1.25rem;
}

@media (min-width: 640px) {
  .si-why__inner {
    padding: 0 2rem;
  }
}

.si-why__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 700;
  letter-spacing: var(--text-etiquette--letter-spacing);
  text-transform: uppercase;
  color: var(--color-navy);
  margin-bottom: 1rem;
}

.si-why__eyebrow-line {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--color-orange);
  border-radius: 1px;
}

.si-why__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  letter-spacing: -0.025em;
  line-height: 1.05;
  color: var(--color-navy);
  margin-bottom: 3rem;
  text-wrap: balance;
}

.si-why__title-accent {
  color: var(--color-orange-texte);
}

.si-why__grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: 1fr;
}

@media (min-width: 640px) {
  .si-why__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .si-why__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.si-why__card {
  background: var(--color-gris);
  border-radius: var(--radius-bloc);
  padding: 1.75rem;
  border: 1px solid transparent;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.si-why__card:hover {
  border-color: color-mix(in srgb, var(--color-navy) 10%, transparent);
  box-shadow: 0 8px 32px color-mix(in srgb, var(--color-navy) 8%, transparent);
  transform: translateY(-2px);
}

.si-why__card-icon {
  font-size: var(--text-sous-titre);
  margin-bottom: 1rem;
  line-height: 1;
}

.si-why__card-title {
  font-family: var(--font-display);
  font-size: var(--text-corps);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--color-navy);
  margin-bottom: 0.625rem;
  line-height: 1.25;
}

.si-why__card-text {
  font-family: var(--font-sans);
  font-size: var(--text-petit);
  font-weight: 300;
  line-height: 1.65;
  color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  text-wrap: pretty;
}
</style>
