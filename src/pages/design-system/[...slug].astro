---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import InfoBox from '../../components/InfoBox.astro';
import OtherServices from '../../components/OtherServices.astro';
import { getServices, getSite } from '../../lib/content.js';
import { getEntry } from 'astro:content';

/**
 * PAGE DE TRAVAIL — disponible en local, absente du site déployé.
 *
 * `getStaticPaths` ne renvoie rien en production : la page n'est donc jamais
 * générée dans dist/. Un prospect ne peut pas tomber sur les coulisses du
 * design system, et 46 Ko de HTML ne partent pas sur le CDN pour rien.
 * En `npm run dev`, elle reste accessible à /design-system.
 */
export function getStaticPaths() {
  if (import.meta.env.PROD) return [];
  return [{ params: { slug: undefined } }];
}

const services = await getServices();
const site = await getSite();
const accueil = await getEntry('home', 'accueil');

const ravalement = services.find((s) => s.data.slug === 'ravalement');
const infosCles = ravalement.data.sections.find((s) => s.type === 'keyFacts');
const faq = ravalement.data.faq.slice(0, 4);
---

<Base
  title="Design system — ALPITEC"
  description="Page de recette interne du design system ALPITEC."
  noindex={true}
>
  <Header />

  <main id="contenu">
    <!-- Échelle typographique -->
    <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
      <span aria-hidden="true" class="mb-6 block h-0.5 w-14 bg-orange"></span>
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-navy/55">
        Design system
      </p>
      <h1 class="mt-4 max-w-[18ch] text-4xl font-bold leading-[1.05] tracking-tight text-navy text-balance sm:text-6xl">
        Le fil orange
      </h1>
      <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-navy/75 text-pretty">
        Navy sur blanc, angles vifs, deux poids d'Inter. L'orange ne sert qu'à
        deux choses : marquer la structure d'un filet de 2 px, et signaler ce qui
        mène au devis ou au téléphone.
      </p>

      <div class="mt-12 grid gap-10 border-t border-navy/12 pt-10 sm:grid-cols-2">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-navy/55">
            Boutons
          </h2>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <Button variant="primaire" size="lg" href="#devis">Demander un devis gratuit</Button>
            <Button variant="secondaire" size="lg" href={`tel:${site.telephone.lien}`}>Nous appeler</Button>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <Button variant="primaire" size="md" href="#devis">Taille md</Button>
            <Button variant="secondaire" size="sm" href="#devis">Taille sm</Button>
          </div>
        </div>

        <div>
          <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-navy/55">
            Couleurs
          </h2>
          <ul class="mt-6 grid grid-cols-4 gap-px bg-navy/12">
            <li class="bg-orange px-3 py-8 text-center text-[0.6875rem] font-bold uppercase tracking-wider text-blanc">Orange</li>
            <li class="bg-navy px-3 py-8 text-center text-[0.6875rem] font-bold uppercase tracking-wider text-blanc">Navy</li>
            <li class="bg-gris px-3 py-8 text-center text-[0.6875rem] font-bold uppercase tracking-wider text-navy/60">Gris</li>
            <li class="bg-blanc px-3 py-8 text-center text-[0.6875rem] font-bold uppercase tracking-wider text-navy/60">Blanc</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- InfoBox -->
    <section class="mx-auto max-w-6xl px-5 pb-14 sm:px-8 sm:pb-20">
      <h2 class="mb-8 border-l-2 border-orange pl-5 text-2xl font-bold tracking-tight text-navy sm:text-3xl">
        InfoBox
      </h2>
      <InfoBox items={infosCles.items} title="Infos clés" />
    </section>

    <!-- ServiceCard -->
    <section class="mx-auto max-w-6xl px-5 pb-14 sm:px-8 sm:pb-20">
      <h2 class="mb-8 border-l-2 border-orange pl-5 text-2xl font-bold tracking-tight text-navy sm:text-3xl">
        ServiceCard
      </h2>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          accueil.data.services.cards.slice(0, 3).map((card) => (
            <li class="flex">
              <ServiceCard service={card} linkLabel={accueil.data.services.linkLabel} />
            </li>
          ))
        }
      </ul>
    </section>

    <!-- FaqAccordion -->
    <section class="mx-auto max-w-3xl px-5 pb-14 sm:px-8 sm:pb-20">
      <FaqAccordion items={faq} title="FaqAccordion" id="faq-demo" />
    </section>

    <!-- CtaBand -->
    <CtaBand
      title={ravalement.data.sections.at(-1).title}
      text={ravalement.data.sections.at(-1).text}
      buttons={ravalement.data.sections.at(-1).buttons}
      id="devis"
    />

    <!-- OtherServices -->
    <OtherServices currentSlug="ravalement" />
  </main>

  <Footer />
</Base>
