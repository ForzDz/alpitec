---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBand from '../components/CtaBand.astro';
import ContactSection from '../components/ContactSection.astro';
import TitreSection from '../components/TitreSection.astro';
import TuileIcone from '../components/TuileIcone.astro';
import { getSite, getAccueil, getServices, getServicePhotos, serviceHref } from '../lib/content.js';
import heroPoster from '../assets/hero-poster.jpg';


/**
 * Poster du hero, passé par le pipeline Astro : WebP, dimensions explicites.
 * `getImage` sert à obtenir une URL utilisable dans l'attribut `poster` de la
 * balise <video>, qui n'accepte pas de composant.
 */
const posterWebp = await getImage({ src: heroPoster, format: 'webp', width: 720, quality: 72 });

/**
 * Page d'accueil.
 *
 * Ordre des sections :
 *   1 Hero (vidéo de chantier en fond, overlay navy)
 *   2 Les 9 services en cartes
 *   3 Bandeau chiffres clés
 *   4 Moyens d'accès
 *   5 Certifications + Comment ça marche + Pourquoi nous choisir
 *   6 Témoignages ANONYMISÉS
 *   7 Zones d'intervention
 *   8 FAQ
 *   9 CtaBand final + Contact
 *
 * Tous les textes viennent de src/content/home/accueil.md. Les deux blocs dont
 * la copie n'est pas tirée des .docx (chiffres clés, moyens d'accès) portent un
 * drapeau `aValider` et déclenchent un avertissement au build.
 */

const site = await getSite();
const d = await getAccueil();
const services = await getServices();

/**
 * Témoignages : seuls ceux marqués `valide: true` sont rendus.
 *
 * Tant que le client n'a pas fourni la fonction des signataires et leur accord
 * écrit, la section entière disparaît. Publier « Fonction à confirmer par le
 * client » sur la preuve sociale d'un site qui vise les grands comptes fait
 * plus de dégâts que de ne rien afficher.
 */
const avisPublies = d.testimonials.items.filter((avis) => avis.valide);

// Chaque carte reçoit sa première photo si le dossier du service en contient une.
const cartes = d.services.cards.map((carte) => {
  const service = services.find((s) => s.data.slug === carte.slug);
  // Le texte alternatif vient du frontmatter du service, apparié par nom de
  // fichier : chaque photo décrit ce qu'elle montre, jamais un libellé générique.
  const legendes = service?.data.sections.find((s) => s.type === 'realisations')?.photos ?? [];
  const [photo] = getServicePhotos(carte.slug, legendes, 1);
  return {
    ...carte,
    ordre: service?.data.ordre,
    shortLabel: service?.data.shortLabel ?? carte.label,
    image: photo?.alt ? { src: photo.src, alt: photo.alt } : undefined,
  };
});

/**
 * Bande de chantiers : jusqu'à quatre photos de src/assets/photos/accueil/,
 * appariées par nom de fichier aux textes alternatifs de accueil.md.
 * Ajouter ou retirer une image du dossier suffit — aucun import à maintenir.
 */
const photosBrutes = getServicePhotos('accueil', d.photosAccueil, 4);

/*
 * La photo `miseEnAvant` tient la rangée pleine largeur, les autres forment le
 * triptyque en dessous. Sans drapeau, on retombe sur l'ordre alphabétique —
 * mais ce n'est alors le choix de personne, d'où l'avertissement au build.
 */
const enTete = photosBrutes.find((p) => p.miseEnAvant);

if (!enTete && photosBrutes.length > 0) {
  console.warn(
    "\n⚠️  ALPITEC — accueil : aucune photo de la bande n'est marquée `miseEnAvant: true`.\n" +
      `   C'est « ${photosBrutes[0].fichier} » qui passera en pleine largeur, par ordre alphabétique.\n` +
      '   Ajouter `miseEnAvant: true` sous la photo voulue dans src/content/home/accueil.md.\n',
  );
}

const photosAccueil = enTete
  ? [enTete, ...photosBrutes.filter((p) => p !== enTete)]
  : photosBrutes;

const reste = photosAccueil.slice(1);
const resteImpair = reste.length % 2 === 1;

/* ------------------------------------------------------------------ JSON-LD */

const accueilUrl = new URL('/', Astro.site).href;
const adresse = {
  '@type': 'PostalAddress',
  ...(site.adresse.rue ? { streetAddress: site.adresse.rue } : {}),
  postalCode: site.adresse.codePostal,
  addressLocality: site.adresse.ville,
  addressRegion: 'Île-de-France',
  addressCountry: 'FR',
};

// Les départements listés dans la section « Zones d'intervention » du document.
const departements = [
  'Paris',
  'Hauts-de-Seine',
  'Seine-Saint-Denis',
  'Val-de-Marne',
  'Yvelines',
  'Essonne',
  "Val-d'Oise",
  'Seine-et-Marne',
];

const anneeCreation = d.chiffres.items.find((i) => i.label === 'Année de création')?.valeur;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': new URL('#entreprise', Astro.site).href,
      name: site.nom,
      description: d.metaDescription,
      url: accueilUrl,
      logo: new URL('/favicon.svg', Astro.site).href,
      telephone: site.telephone.lien,
      email: site.email,
      address: adresse,
      ...(anneeCreation ? { foundingDate: anneeCreation } : {}),
      // `horaires` est encore vide dans coordonnees.md : on n'émet pas de
      // openingHours plutôt qu'une valeur inventée.
      ...(site.horaires ? { openingHours: site.horaires } : {}),
      areaServed: departements.map((nom) => ({ '@type': 'AdministrativeArea', name: nom })),
      knowsAbout: services.map((s) => s.data.title),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: d.services.title,
        itemListElement: services.map((s) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: s.data.title,
            url: new URL(serviceHref(s.data.slug), Astro.site).href,
          },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${accueilUrl}#site`,
      name: site.nom,
      url: accueilUrl,
      inLanguage: 'fr-FR',
      publisher: { '@id': new URL('#entreprise', Astro.site).href },
    },
    {
      '@type': 'FAQPage',
      '@id': `${accueilUrl}#faq`,
      mainEntity: d.faq.items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<Base title={d.metaTitle} description={d.metaDescription} canonical="/">
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  <Header transparent />

  <main id="contenu">
    {/*
      ---------------------------------------------------------- 1. Hero

      `-mt-16 sm:-mt-20` remonte la section de la hauteur exacte du header, et
      le padding interne la compense au pixel près : la vidéo passe derrière le
      header sans qu'aucun contenu ne bouge.
    */}
    <section class="relative isolate -mt-16 overflow-hidden bg-navy sm:-mt-20">
      {/*
        Fond du hero.

        Sur mobile, seule l'image est chargée : `autoplay` annule `preload`, donc
        déclarer une <video> ici coûterait 467 Ko à chaque première visite pour
        un décor. La balise est injectée en JavaScript à partir de 640 px de
        large, et jamais si le visiteur demande moins de mouvement.

        Cadrage : la source est en portrait. Un cadrage centré sortirait le
        cordiste du champ sur mobile — d'où le décalage à 62 % / 30 %. À partir
        de `sm`, le hero s'élargit et le centrage redevient le bon choix.
      */}
      <div
        class="absolute inset-0 -z-10 overflow-hidden"
        data-hero-fond
        data-video="/videos/hero-chantier.mp4"
        data-poster={posterWebp.src}
      >
        <Image
          src={heroPoster}
          alt=""
          aria-hidden="true"
          width={1080}
          widths={[480, 720, 1080]}
          sizes="100vw"
          format="webp"
          quality={72}
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover object-[62%_30%] sm:object-center"
        />
      </div>

      {/*
        Overlay navy. Dosage : assez dense pour que le blanc reste très
        au-dessus du seuil AA sur n'importe quelle image de la vidéo, assez
        léger pour qu'on distingue le cordiste. Plus opaque en bas, là où se
        trouvent les CTA. Contraste mesuré : voir le rapport.
      */}
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-gradient-to-b from-navy/75 via-navy/82 to-navy/92"
      >
      </div>

      {/*
        Voile supplémentaire sur la bande du header transparent : garantit que
        le logo blanc et les liens restent au-dessus du seuil AA quelle que
        soit l'image de la vidéo qui défile derrière.
      */}
      <div
        aria-hidden="true"
        class="absolute inset-x-0 top-0 -z-10 h-32 bg-gradient-to-b from-navy/70 to-transparent sm:h-40"
      >
      </div>

      {/*
        Sentinelle du header : tant qu'elle est visible, le header reste
        transparent. Sa hauteur fixe le seuil de bascule (80 px).
      */}
      <span
        aria-hidden="true"
        data-sentinelle-entete
        class="pointer-events-none absolute inset-x-0 top-0 h-20"
      ></span>

      {/*
        pt = hauteur du header (4rem puis 5rem) + le py d'origine, au pixel près.

        pb sur mobile : 6,5 rem, soit la barre d'action fixe (3,5 rem) plus une
        respiration. À 4 rem, les badges arrivaient à 8 px de la barre quand on
        atteignait le bas du hero — assez pour qu'ils paraissent collés dessous
        sur un écran de 320 px. Au-delà de `sm` la barre n'existe plus et on
        reprend le rythme normal.
      */}
      <div class="mx-auto max-w-6xl px-5 pb-[6.5rem] pt-[7.5rem] sm:px-8 sm:pb-24 sm:pt-[11rem] lg:pb-32 lg:pt-[13rem]">
        {/*
          LA CORDE, version longue — la seule de la page. Elle descend d'un
          seul trait du surtitre jusqu'aux boutons et sort du cadre en fondu.
          Ailleurs sur l'accueil, seul le bandeau de conversion en reprend une
          version courte : répétée à chaque section, elle redeviendrait le
          filet décoratif qu'on vient de supprimer.
        */}
        <div class="corde corde-descend">
          <p class="max-w-[24ch] font-display text-etiquette uppercase text-blanc/85 text-balance sm:max-w-none">
            {d.hero.surtitre}
          </p>

          {/*
            `text-affiche` plafonne à 4,5 rem ; on redescend sous 360 px de
            large, où sept lignes de titre poussaient le bouton de devis sous
            la ligne de flottaison.
          */}
          <h1 class="mt-7 max-w-[16ch] text-[clamp(2.125rem,9.5vw,4.5rem)] font-extrabold leading-[0.99] tracking-[-0.035em] text-blanc text-balance sm:mt-8 sm:max-w-[15ch]">
            {d.hero.h1}
          </h1>

          {/* Mobile : une seule phrase, la plus différenciante des documents. */}
          <p class="mt-7 max-w-[30ch] text-sous-titre text-blanc text-balance sm:hidden">
            {d.hero.introCourte}
          </p>

          {/* Desktop : l'accroche complète du document. */}
          <p class="mt-7 hidden max-w-[58ch] text-corps-large font-light text-blanc/85 text-pretty sm:block">
            {d.hero.intro}
          </p>

          {/*
            Deux boutons empilés, pleine largeur : le devis en aplat orange,
            le numéro juste en dessous en contour clair. Le numéro est écrit en
            toutes lettres plutôt que « Nous appeler » — un visiteur qui hésite
            à cliquer peut le composer directement.

            Le bloc est borné à `max-w-md` : au-delà, sur un hero en `max-w-6xl`,
            un aplat orange de 1 150 px de large cesse de se lire comme un
            bouton. La contrainte tombe si tu veux vraiment du bord à bord.
          */}
          <div class="mt-9 flex max-w-md flex-col gap-3">
            <Button
              href="#devis"
              variant="primaire"
              size="lg"
              class="w-full"
              data-cta="devis-hero"
            >
              {d.hero.buttons[0].label}
              {/* Flèche décorative : hors du contenu, jamais lue à voix haute. */}
              <span aria-hidden="true">→</span>
            </Button>
            <Button
              href={`tel:${site.telephone.lien}`}
              variant="clair"
              size="lg"
              class="w-full"
              data-cta="tel-hero"
            >
              {site.telephone.affichageInternational}
            </Button>
          </div>
        </div>

        {/*
          Les badges deviennent des pastilles posées sur le navy éclairci : sur
          un fond sombre, la profondeur vient de la valeur, pas de l'ombre.
        */}
        <ul class="mt-14 flex flex-wrap gap-2.5">
          {
            d.hero.badges.map((badge) => (
              <li class="flex items-center gap-2.5 rounded-tuile bg-navy-clair/70 px-4 py-2.5 backdrop-blur-sm">
                <span aria-hidden="true" class="h-3.5 w-0.5 shrink-0 rounded-full bg-orange" />
                <span class="font-display text-[0.8125rem] font-bold tracking-tight text-blanc">
                  {badge}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/*
      ═══ RYTHME DE LA PAGE ═══

      Aucune section voisine ne partage ni son fond ni sa mise en page :

        2  Services        blanc        en-tête 5/7, grille de 9 cartes
        3  Chiffres        navy plein   quatre colonnes, chiffres très gros
        4  Chantiers       PHOTO        pleine largeur, la respiration
        5  Moyens d'accès  blanc        titre à gauche collant, cartes à droite
        6  Certifications  navy plein   plaque de qualification
        7  Méthode         gris         grille décalée
        8  Pourquoi nous   blanc        deux colonnes de cartes
        9  Témoignages     gris         (masqué tant qu'aucun avis validé)
       10  Zones           navy plein   colonne unique + encart
       11  FAQ             blanc        colonne étroite
       12  Conversion      navy profond bandeau
       13  Contact         gris         formulaire
    */}

    {/* ------------------------------------------------------ 2. Services */}
    <section
      class="mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8"
      aria-labelledby="services"
      data-reveal
    >
      <div class="grid gap-x-16 gap-y-8 lg:grid-cols-12">
        <TitreSection texte={d.services.title} id="services" class="max-w-[14ch] lg:col-span-5" />
        <p class="max-w-[56ch] self-end text-corps font-light text-navy/75 text-pretty lg:col-span-7">
          {d.services.intro}
        </p>
      </div>

      <ul class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          cartes.map((carte) => (
            <li class="flex">
              <ServiceCard service={carte} image={carte.image} linkLabel={d.services.linkLabel} />
            </li>
          ))
        }
      </ul>
    </section>

    {/* ------------------------------------------------- 3. Chiffres clés */}
    <section class="relative overflow-hidden bg-navy" aria-labelledby="chiffres" data-reveal>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -left-40 top-1/2 size-[32rem] -translate-y-1/2 rounded-full bg-orange/10 blur-3xl"
      ></span>

      <div class="relative mx-auto max-w-6xl px-5 py-[var(--espace-section-serre)] sm:px-8">
        <h2 id="chiffres" class="sr-only">{d.chiffres.title}</h2>

        {/*
          Les chiffres s'incrémentent quand la section entre à l'écran.

          La valeur définitive est écrite dans le HTML, jamais calculée : sans
          JavaScript, ou avec `prefers-reduced-motion`, elle s'affiche
          directement. Le script ne fait que remplacer temporairement le texte
          pendant le comptage, puis restitue la chaîne d'origine au caractère
          près — c'est elle qui porte l'espace de milliers et le « + ».

          `tabular-nums` fige la largeur des chiffres : sans lui, « 1 » et « 7 »
          n'ont pas la même chasse et le nombre tremble pendant l'animation.
        */}
        <dl class="grid grid-cols-2 gap-x-8 gap-y-12 lg:grid-cols-4" data-chiffres>
          {
            d.chiffres.items.map((item) => (
              <div>
                <dt class="sr-only">{item.label}</dt>
                <dd>
                  {/*
                    La valeur est écrite deux fois : une version lue par les
                    lecteurs d'écran, toujours exacte, et la version affichée
                    qui, elle, peut être en train de compter. Sans ça, un
                    lecteur d'écran arrivant au milieu de l'animation
                    annoncerait un nombre intermédiaire.
                  */}
                  <span class="sr-only">{item.valeur}</span>
                  <span
                    aria-hidden="true"
                    class="block font-display text-[clamp(2.5rem,7vw,3.75rem)] font-extrabold leading-[0.9] tracking-[-0.04em] tabular-nums text-blanc"
                    data-chiffre
                  >
                    {item.valeur}
                  </span>
                  <span
                    aria-hidden="true"
                    class="mt-5 block h-0.5 w-10 rounded-full bg-orange"
                  ></span>
                  <span class="mt-4 block text-[0.8125rem] font-light leading-snug text-blanc/70 text-pretty">
                    {item.label}
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {/*
      ------------------------------------------------- 4. Bande de chantiers

      LA RESPIRATION de la page : pleine largeur, bord à bord, sans titre ni
      texte par-dessus. Ces photos ne portent pas de discours — elles montrent
      le métier, ce qu'aucun paragraphe ne fait à leur place.

      La première occupe deux colonnes en 16/9, les autres suivent en 4/3 :
      l'œil entre par une grande image, pas par une rangée de vignettes égales.
      Traitement unifié par `.photo` (contraste +8 %, saturation −5 %, voile
      navy 6 %) — dix chantiers photographiés dans dix conditions finissent par
      former une série.
    */}
    {
      photosAccueil.length > 0 && (
        <section class="bg-navy" aria-label="Chantiers ALPITEC" data-reveal>
          {/*
            Deux rangées plutôt qu'une grille unique : avec quatre photos, une
            première image à cheval sur deux colonnes laissait la quatrième
            seule sur une deuxième rangée, orpheline et d'un autre format.
            Ici la grande photo occupe sa propre rangée pleine largeur, et les
            suivantes forment un triptyque en dessous.
          */}
          <div class="photo aspect-[4/3] w-full sm:aspect-[16/9] sm:max-h-[68vh]">
            <Image
              src={photosAccueil[0].src}
              alt={photosAccueil[0].alt}
              width={1920}
              widths={[480, 768, 1280, 1920]}
              sizes="100vw"
              format="webp"
              quality={72}
              loading="lazy"
              decoding="async"
            />
          </div>

          {reste.length > 0 && (
            <ul
              class:list={[
                'mt-1 grid grid-cols-2 gap-1',
                // La grille se cale sur le nombre restant : à trois photos on
                // passe en trois colonnes, à deux on en garde deux, et aucune
                // case ne reste vide au bout de la rangée.
                reste.length % 3 === 0 ? 'lg:grid-cols-3' : 'lg:grid-cols-2',
              ]}
            >
              {reste.map((photo, i) => (
                <li
                  class:list={[
                    'relative',
                    // Nombre impair : la dernière prend toute la largeur sur
                    // mobile plutôt que de laisser une case vide à côté d'elle.
                    resteImpair && i === reste.length - 1 && 'col-span-2 lg:col-span-1',
                  ]}
                >
                  <div class="photo aspect-[4/3] h-full w-full">
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      width={720}
                      widths={[320, 480, 720]}
                      sizes="(min-width: 1024px) 33vw, 50vw"
                      format="webp"
                      quality={70}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    {/* ------------------------------------------------ 5. Moyens d'accès */}
    {/*
      Deux colonnes asymétriques : le titre tient seul à gauche et reste collé
      pendant que les trois moyens défilent à droite.
    */}
    <section
      class="mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8"
      aria-labelledby="moyens"
      data-reveal
    >
      <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            <TitreSection texte={d.moyensAcces.title} id="moyens" class="max-w-[14ch]" />
            <p class="mt-6 max-w-[44ch] text-corps font-light text-navy/75 text-pretty">
              {d.moyensAcces.intro}
            </p>
          </div>
        </div>

        <ul class="grid gap-4 lg:col-span-7">
          {
            d.moyensAcces.items.map((item, i) => (
              <li class="eleve flex gap-5 rounded-carte bg-blanc p-6 sm:p-7">
                <TuileIcone variant={i === 0 ? 'orange' : 'navy'}>
                  <span class="font-display text-sm font-bold">{i + 1}</span>
                </TuileIcone>
                <div class="min-w-0">
                  <h3 class="text-carte text-navy text-balance">{item.label}</h3>
                  <p class="mt-2.5 max-w-[52ch] text-petit font-light text-navy/75 text-pretty">
                    {item.text}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ---------------------------------------------- 6. Certifications */}
    {/*
      Plaque de qualification, pas grille de cartes : c'est le bloc qu'un
      conducteur de travaux lit en premier quand il vérifie un sous-traitant.
      Acronymes en très gros sur navy éclairci, chiffre de rang, intro en
      vis-à-vis du titre plutôt qu'au-dessus.
    */}
    <section class="bg-navy text-blanc" aria-labelledby="certifications" data-reveal>
      <div class="mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8">
        <div class="grid gap-x-16 gap-y-8 lg:grid-cols-12">
          <TitreSection
            texte={d.certifications.title}
            id="certifications"
            ton="clair"
            class="max-w-[14ch] lg:col-span-5"
          />
          <p class="max-w-[56ch] self-end text-corps font-light text-blanc/80 text-pretty lg:col-span-7">
            {d.certifications.intro}
          </p>
        </div>

        <dl class="mt-16 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            d.certifications.items.map((item, i) => (
              <div class="rounded-carte bg-navy-clair p-6">
                {/*
                  Rang en blanc, pas en orange : sur le navy éclairci l'orange
                  tombe à 3,7:1 pour 11 px. La règle du site vaut aussi pour un
                  élément décoratif — pas d'orange en texte sous 24 px.
                */}
                <span aria-hidden="true" class="block font-display text-etiquette text-blanc/70">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <dt class="mt-5 font-display text-[1.75rem] font-extrabold leading-none tracking-[-0.03em] sm:text-3xl">
                  {item.label}
                </dt>
                <dd class="mt-3 text-[0.8125rem] font-light leading-snug text-blanc/70 text-pretty">
                  {item.text}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {/* --------------------------------------------- 7. Comment ça marche */}
    {/* Grille décalée : une étape sur deux descend d'un demi-pas sur écran
        large, la lecture cesse d'être une rangée de cases alignées. */}
    <section class="bg-gris" aria-labelledby="methode" data-reveal>
      <div class="mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8">
        <div class="grid gap-x-16 gap-y-8 lg:grid-cols-12">
          <TitreSection texte={d.process.title} id="methode" class="max-w-[14ch] lg:col-span-5" />
          <p class="max-w-[56ch] self-end text-corps font-light text-navy/75 text-pretty lg:col-span-7">
            {d.process.intro}
          </p>
        </div>

        <ol class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            d.process.steps.map((step, i) => (
              <li class:list={['eleve rounded-carte bg-blanc p-6', i % 2 === 1 && 'lg:mt-12']}>
                <TuileIcone variant={i === 0 ? 'orange' : 'navy'} taille="sm">
                  <span class="font-display text-[0.8125rem] font-bold">{i + 1}</span>
                </TuileIcone>
                <p class="mt-5 font-display text-etiquette uppercase text-navy/70">{step.step}</p>
                <h3 class="mt-2 text-carte text-navy text-balance">{step.label}</h3>
                <p class="mt-3 text-petit font-light text-navy/75 text-pretty">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ---------------------------------------- 8. Pourquoi nous choisir */}
    <section
      class="mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8"
      aria-labelledby="pourquoi"
      data-reveal
    >
      <div class="grid gap-x-16 gap-y-8 lg:grid-cols-12">
        <TitreSection texte={d.why.title} id="pourquoi" class="max-w-[14ch] lg:col-span-5" />
        <p class="max-w-[56ch] self-end text-corps font-light text-navy/75 text-pretty lg:col-span-7">
          {d.why.intro}
        </p>
      </div>

      <ul class="mt-16 grid gap-6 sm:grid-cols-2">
        {
          d.why.items.map((item) => (
            <li class="eleve rounded-carte bg-blanc p-7 sm:p-8">
              <h3 class="text-carte text-navy text-balance">{item.label}</h3>
              <p class="mt-3 text-petit font-light text-navy/75 text-pretty">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* --------------------------------------------------- 9. Témoignages */}
    {/*
      Avis NOMINATIFS depuis le 14 août 2026 : le client a fourni l'accord
      écrit des trois signataires, ce qui lève la règle d'anonymisation.
      Format : « citation » — Nom, Entreprise.

      Le verrou reste en place : la section n'apparaît que si au moins un avis
      porte `valide: true`, et ce drapeau ne se lève qu'accord en main. Un avis
      ajouté sans accord reste donc invisible sans que personne ait à y penser.
    */}
    {avisPublies.length > 0 && (
      <section class="bg-gris" aria-labelledby="temoignages" data-reveal>
        <div class="mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8">
          <div class="grid gap-x-16 gap-y-8 lg:grid-cols-12">
            <TitreSection
              texte={d.testimonials.title}
              id="temoignages"
              class="max-w-[14ch] lg:col-span-5"
            />
            <p class="max-w-[56ch] self-end text-corps font-light text-navy/75 text-pretty lg:col-span-7">
              {d.testimonials.intro}
            </p>
          </div>

          <ul class="mt-16 grid gap-6 lg:grid-cols-3">
            {avisPublies.map((avis) => (
              <li class="flex">
                <figure class="flex h-full flex-col rounded-carte bg-blanc p-7 shadow-repos">
                  <span
                    aria-hidden="true"
                    class="mb-5 block h-0.5 w-9 rounded-full bg-orange"
                  ></span>
                  <blockquote class="flex-1">
                    <p class="text-petit font-light leading-relaxed text-navy/85 text-pretty">
                      {avis.quote}
                    </p>
                  </blockquote>
                  {/*
                    Le nom porte la graisse et le navy plein, l'entreprise
                    suit en gris : c'est la personne qui signe, l'entreprise
                    situe. La fonction s'intercale quand le client l'a donnée.
                  */}
                  <figcaption class="mt-6 border-t border-gris-bord pt-4 text-[0.8125rem] font-light leading-snug text-navy/70">
                    <span class="block font-display text-[0.9375rem] font-bold tracking-tight text-navy">
                      {avis.nom}
                    </span>
                    <span class="mt-0.5 block">
                      {avis.role ? `${avis.role}, ${avis.company}` : avis.company}
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* ------------------------------------------------------ 10. Zones */}
    <section class="relative overflow-hidden bg-navy" aria-labelledby="zones" data-reveal>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -right-32 top-1/2 size-[30rem] -translate-y-1/2 rounded-full bg-orange/10 blur-3xl"
      ></span>

      <div class="relative mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8">
        <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
          <div class="min-w-0 lg:col-span-7">
            <TitreSection texte={d.zones.title} id="zones" ton="clair" class="max-w-[16ch]" />
            {
              d.zones.paragraphs.map((paragraphe) => (
                <p class="mt-6 max-w-[60ch] text-corps-large font-light text-blanc/80 text-pretty">
                  {paragraphe}
                </p>
              ))
            }
          </div>

          <aside class="min-w-0 lg:col-span-5">
            <div class="rounded-carte bg-navy-clair p-6 sm:p-8">
              {/* Même règle que les rangs de certification : pas d'orange en
                  texte à 11 px, il tombe à 3,7:1 sur le navy éclairci. */}
              <h3 class="flex items-center gap-3 font-display text-etiquette uppercase text-blanc/70">
                <span aria-hidden="true" class="h-3 w-0.5 shrink-0 rounded-full bg-orange"></span>
                {d.zones.encart.label}
              </h3>
              <p class="mt-4 text-petit font-light text-blanc/80 text-pretty">
                {d.zones.encart.text}
              </p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------- 11. FAQ */}
    <div class="mx-auto max-w-3xl px-5 py-[var(--espace-section)] sm:px-8">
      <FaqAccordion items={d.faq.items} title={d.faq.title} id="faq-accueil" />
    </div>

    {/* ------------------------------------------------- 9. CtaBand final */}
    <CtaBand
      title={d.contact.title}
      text={d.contact.text}
      buttons={[
        { label: 'Demander mon devis gratuit', action: 'devis' },
        { label: 'Nous appeler', action: 'tel' },
      ]}
    />

    {/* Le CtaBand ci-dessus porte déjà le titre du bloc contact du document :
        on ne le répète pas ici, le formulaire devient l'intitulé de la section. */}
    <ContactSection id="devis" avecIntro={false} />
  </main>

  <Footer />
</Base>

<script>
  /**
   * Montage conditionnel de la vidéo du hero.
   *
   * MOBILE COMPRIS depuis août 2026, à la demande du client. Le seuil de 640 px
   * a sauté : la vidéo tourne sur téléphone comme sur ordinateur. Ce qui rend
   * la chose tenable, c'est le poids — le fichier doit rester sous 600 Ko,
   * sinon on retombe dans le problème que le seuil évitait (467 Ko facturés à
   * chaque première visite mobile pour un décor).
   *
   * Trois garde-fous demeurent, et ils ne sont pas négociables :
   *   · `prefers-reduced-motion` — accessibilité, une vidéo en boucle plein
   *     écran est exactement ce que ce réglage existe pour éteindre ;
   *   · `saveData` — le visiteur a explicitement demandé l'économie de données ;
   *   · connexion 2G — sur ce débit la vidéo arriverait après le départ.
   * Dans ces trois cas, le poster WebP suffit et rien n'est téléchargé.
   *
   * Le montage reste en JavaScript plutôt qu'en balise <video> : `autoplay`
   * annule `preload`, donc déclarer la balise dans le HTML ferait concurrence
   * au LCP. Injectée après le premier rendu, la vidéo se superpose au poster
   * dans le même conteneur absolu — aucun décalage de mise en page.
   */
  /**
   * Comptage des chiffres clés à l'entrée de la section.
   *
   * Amélioration progressive stricte : la valeur définitive est déjà dans le
   * HTML. Ce script ne fait que la remplacer le temps du comptage, puis
   * restitue la chaîne d'origine au caractère près — l'espace de milliers et
   * le « + » de « 7 000+ » viennent du contenu, jamais d'un reformatage.
   *
   * Se déclenche UNE fois, puis cesse d'observer. Ne se déclenche pas du tout
   * si le visiteur a demandé moins de mouvement : dans ce cas les chiffres
   * sont simplement là, ce qui est leur état final de toute façon.
   */
  const grilleChiffres = document.querySelector('[data-chiffres]');

  if (grilleChiffres && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const compteurs = [...grilleChiffres.querySelectorAll('[data-chiffre]')]
      .map((el) => {
        const brut = el.textContent.trim();
        const premier = brut.search(/\d/);
        const dernier = brut.search(/\d(?!.*\d)/);
        if (premier === -1) return null;

        // Séparateur de milliers réellement employé dans le contenu, s'il y en
        // a un : « 7 000+ » donne l'espace, « 2009 » ne donne rien. On ne
        // décide pas du format, on le relit.
        const separateur = (brut.match(/\d(\D)\d{3}(?!\d)/) || [])[1] ?? '';

        return {
          el,
          brut,
          cible: Number(brut.slice(premier, dernier + 1).replace(/\D/g, '')),
          avant: brut.slice(0, premier),
          apres: brut.slice(dernier + 1),
          separateur,
        };
      })
      .filter(Boolean);

    if (compteurs.length > 0 && 'IntersectionObserver' in window) {
      const formater = (n, separateur) => {
        const s = String(n);
        return separateur ? s.replace(/\B(?=(\d{3})+(?!\d))/g, separateur) : s;
      };

      const compter = () => {
        const duree = 1100;
        const debut = performance.now();

        const image = (maintenant) => {
          const t = Math.min((maintenant - debut) / duree, 1);
          // easeOutCubic : rapide au départ, s'installe sur la fin.
          const progression = 1 - Math.pow(1 - t, 3);

          for (const c of compteurs) {
            if (t < 1) {
              c.el.textContent =
                c.avant + formater(Math.round(c.cible * progression), c.separateur) + c.apres;
            } else {
              // Dernière image : on repose la chaîne du contenu, telle quelle.
              c.el.textContent = c.brut;
            }
          }

          if (t < 1) requestAnimationFrame(image);
        };

        requestAnimationFrame(image);
      };

      const observateur = new IntersectionObserver(
        (entrees) => {
          for (const entree of entrees) {
            if (entree.isIntersecting) {
              observateur.disconnect();
              compter();
            }
          }
        },
        { threshold: 0.35 },
      );

      observateur.observe(grilleChiffres);
    }
  }

  const fond = document.querySelector('[data-hero-fond]');

  if (fond) {
    const mouvementReduit = matchMedia('(prefers-reduced-motion: reduce)');
    const connexion = navigator.connection;
    const economieDonnees = connexion?.saveData === true;
    const tresLent = /(^|-)2g$/.test(connexion?.effectiveType ?? '');
    let montee = false;

    const monter = () => {
      if (montee || mouvementReduit.matches || economieDonnees || tresLent) return;
      montee = true;

      const video = document.createElement('video');
      video.src = fond.dataset.video;
      video.poster = fond.dataset.poster;
      video.autoplay = true;
      video.muted = true;
      video.loop = true;
      video.playsInline = true;
      video.tabIndex = -1;
      video.setAttribute('aria-hidden', 'true');
      video.className = 'absolute inset-0 h-full w-full object-cover';
      fond.appendChild(video);
    };

    /*
     * Montée après le chargement complet : la vidéo ne dispute sa bande
     * passante ni au poster, ni aux polices, ni au CSS. Sur mobile c'est la
     * différence entre un LCP intact et un LCP dégradé.
     */
    if (document.readyState === 'complete') monter();
    else addEventListener('load', monter, { once: true });

    mouvementReduit.addEventListener('change', monter);
  }
</script>
