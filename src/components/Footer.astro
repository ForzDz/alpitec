---
import { getSite, getServices, serviceHref, whatsappHref } from '../lib/content.js';

/**
 * Pied de page — coordonnées, la liste des services, certifications, mentions.
 *
 * La liste des services est calculée depuis la collection, comme partout
 * ailleurs : jamais de liste écrite à la main.
 *
 * Aplat navy : il ferme la page en écho au CtaBand, et laisse le blanc au
 * contenu utile au-dessus.
 */

const site = await getSite();
const services = await getServices();
const annee = new Date().getFullYear();

const adresseComplete = [site.adresse.rue, `${site.adresse.codePostal} ${site.adresse.ville}`]
  .filter((l) => l.trim())
  .join(', ');
---

<footer class="bg-navy-profond text-blanc border-t border-blanc/10">
  <div class="mx-auto max-w-6xl px-5 pt-12 pb-32 sm:px-8 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <!-- Identité + baseline -->
      <div class="lg:col-span-5">
        <svg
          viewBox="0 0 100 100"
          class="h-10 w-auto"
          role="img"
          aria-label={site.nom}
        >
          <path fill="#F96500" d="M34.6 0h28.9L30.2 100H1.3z" />
          <path fill="currentColor" d="M50.5 39.7h27.3L98.4 100H69.8z" />
        </svg>

        <p class="mt-4 max-w-[36ch] text-sm leading-relaxed text-blanc/70 text-pretty">
          {site.baseline} à Paris et sur l'ensemble de l'Île-de-France.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-2 text-xs text-blanc/70">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-blanc/10 bg-blanc/[0.04] px-3 py-1 text-blanc/80">
            <span class="size-1.5 rounded-full bg-orange"></span>
            Cordistes CQP & IRATA
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-blanc/10 bg-blanc/[0.04] px-3 py-1 text-blanc/80">
            <span class="size-1.5 rounded-full bg-orange"></span>
            Garantie décennale
          </span>
        </div>
      </div>

      <!-- Navigation rapide -->
      <div class="lg:col-span-3">
        <h2 class="font-display text-xs font-bold uppercase tracking-wider text-blanc/70">
          Navigation
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href="/" class="text-blanc/75 transition-colors hover:text-orange">Accueil</a>
          </li>
          <li>
            <a href="/services" class="text-blanc/75 transition-colors hover:text-orange">Toutes nos prestations sur cordes</a>
          </li>
          <li>
            <a href="/contact" class="text-blanc/75 transition-colors hover:text-orange">Contact & Devis gratuit</a>
          </li>
          <li>
            <a href="#devis" class="font-semibold text-orange transition-colors hover:underline">Demander un devis en ligne →</a>
          </li>
        </ul>
      </div>

      <!-- Contact direct & Zones -->
      <div class="lg:col-span-4">
        <h2 class="font-display text-xs font-bold uppercase tracking-wider text-blanc/70">
          Contact & Urgences
        </h2>
        <address class="mt-4 space-y-3 text-sm not-italic text-blanc/75">
          <p>
            <a
              href={`tel:${site.telephone.lien}`}
              class="inline-flex items-center gap-2 font-bold text-blanc transition-colors hover:text-orange"
              data-cta="tel-footer"
            >
              <svg class="size-4 text-orange" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 3h3l1.5 4L6.5 8.5a11 11 0 005 5L13 11.5l4 1.5v3a1 1 0 01-1 1A13 13 0 013 4a1 1 0 011-1z" />
              </svg>
              {site.telephone.affichage}
            </a>
          </p>

          <p>
            <a
              href={`mailto:${site.email}`}
              class="inline-flex items-center gap-2 transition-colors hover:text-blanc"
            >
              <svg class="size-4 text-orange/70" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 4h14a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V5a1 1 0 011-1zM3 5l7 6 7-6" />
              </svg>
              {site.email}
            </a>
          </p>

          {
            site.horaires && (
              <p class="flex items-center gap-2 text-blanc/70">
                <svg class="size-4 shrink-0 text-orange/70" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M10 2.5a7.5 7.5 0 100 15 7.5 7.5 0 000-15zM10 6v4.2l2.8 1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {site.horaires}
              </p>
            )
          }

          {
            adresseComplete && (
              <p class="flex items-center gap-2 text-blanc/70">
                <svg class="size-4 shrink-0 text-orange/70" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M10 2a6 6 0 00-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 00-6-6zm0 8a2 2 0 110-4 2 2 0 010 4z" />
                </svg>
                {adresseComplete}
              </p>
            )
          }
        </address>
      </div>
    </div>

    <!-- Mentions -->
    <div
      class="mt-14 flex flex-col gap-4 border-t border-blanc/15 pt-7 text-[0.8125rem] text-blanc/70 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {annee} {site.legal.copyright}
        {site.legal.siret && <span class="ml-2">SIRET {site.legal.siret}</span>}
      </p>

      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          site.legal.liens.map((lien) => (
            <li>
              <a
                href={lien.href}
                class="-my-3.5 inline-flex items-center py-3.5 transition-colors duration-150 hover:text-blanc focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange"
              >
                {lien.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
