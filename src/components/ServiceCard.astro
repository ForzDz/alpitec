---
import { Image } from 'astro:assets';
import { serviceHref } from '../lib/content.js';

/**
 * ServiceCard — Carte Translucide & Photo Pleine Hauteur (Style Glassmorphic)
 *
 * - Image 100% plein format sur toute la surface de la carte (zéro bloc blanc)
 * - Badge flottant supérieur en verre dépoli
 * - Capsule de contenu inférieure en verre dépoli avec flou d'arrière-plan (backdrop-blur)
 * - Typographie contrastée et flèche orange élégante
 */

const { service, linkLabel = 'Voir le service', image, class: className = '' } = Astro.props;

const slug = service.slug;
const title = service.title ?? service.label;
const shortLabel = service.shortLabel ?? service.label ?? title;
const accroche = service.text ?? service.intro;
const ordre = service.ordre ?? 1;
const formattedOrdre = String(ordre).padStart(2, '0');
---

<article class={`group relative flex min-h-[420px] sm:min-h-[460px] w-full flex-col justify-between overflow-hidden rounded-3xl border border-navy/15 shadow-md transition-all duration-300 hover:shadow-2xl hover:border-orange/40 hover:-translate-y-1.5 ${className}`}>
  {/* Photo en arrière-plan plein cadre */}
  <div class="absolute inset-0 -z-10 overflow-hidden bg-navy-profond">
    {image ? (
      <Image
        src={image.src}
        alt={image.alt}
        width={720}
        widths={[320, 480, 720]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        format="webp"
        quality={75}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full w-full flex-col justify-between bg-gradient-to-br from-navy to-navy-profond p-6" aria-hidden="true">
        <span class="font-display text-5xl font-extrabold text-orange/20">{formattedOrdre}</span>
        <span class="font-display text-lg font-bold uppercase tracking-wider text-white/90">{shortLabel}</span>
      </div>
    )}

    {/* Voile dégradé léger pour assurer la lisibilité sans masquer la photo */}
    <div class="absolute inset-0 bg-gradient-to-t from-navy-profond/90 via-navy-profond/20 to-black/25" aria-hidden="true"></div>
  </div>

  {/* Badge supérieur en verre dépoli */}
  <div class="p-4 sm:p-5 flex items-center justify-between z-10">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-navy-profond/80 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white backdrop-blur-md border border-white/15 shadow-sm" aria-hidden="true">
      <span class="text-orange">{formattedOrdre}</span>
      <span class="text-white/30">·</span>
      <span class="text-white/90">Cordistes</span>
    </span>
  </div>

  {/* Capsule inférieure en verre dépoli translucide (Glassmorphism) */}
  <div class="m-3 sm:m-4 rounded-2xl border border-white/15 bg-navy-profond/75 p-5 backdrop-blur-xl shadow-xl transition-colors duration-200 group-hover:bg-navy-profond/85 group-hover:border-orange/40 z-10">
    <h3 class="font-display text-lg font-bold tracking-tight text-white transition-colors duration-200 group-hover:text-orange text-balance leading-snug">
      <a
        href={serviceHref(slug)}
        class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange"
      >
        {title}
      </a>
    </h3>

    {accroche && (
      <p class="mt-2 text-xs sm:text-sm font-light leading-relaxed text-white/75 line-clamp-2 text-pretty">
        {accroche}
      </p>
    )}

    <div class="mt-3.5 pt-3 border-t border-white/10 flex items-center justify-between">
      <span class="inline-flex items-center gap-1.5 font-display text-xs font-bold uppercase tracking-wider text-orange transition-transform duration-200 group-hover:translate-x-0.5">
        <span>{linkLabel}</span>
        <svg
          width="13"
          height="13"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          class="shrink-0 transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true"
        >
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </div>
</article>
