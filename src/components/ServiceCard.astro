---
import { Image } from 'astro:assets';
import { serviceHref } from '../lib/content.js';

/**
 * ServiceCard — Design Premium Apple / Linear
 *
 * Deux variantes :
 *  - featured (1ère carte) : grande image plein fond avec overlay et typographie contrastée
 *  - standard : carte élégante avec tag glassmorphic sur l'image, typographie percutante et bouton d'action interactif
 */

const { service, linkLabel = 'En savoir plus', image, featured = false, class: className = '' } = Astro.props;

const slug = service.slug;
const title = service.title ?? service.label;
const shortLabel = service.shortLabel ?? service.label ?? title;
const accroche = service.text ?? service.intro;
const ordre = service.ordre ?? 1;
const formattedOrdre = String(ordre).padStart(2, '0');
---

{featured ? (
  /* ── CARTE VEDETTE (1ère carte) ── */
  <article class={`sc-featured group relative flex h-full w-full flex-col overflow-hidden rounded-2xl ${className}`}>
    <div class="sc-featured__img-wrap">
      {image ? (
        <Image
          src={image.src}
          alt={image.alt}
          width={960}
          widths={[480, 768, 960]}
          sizes="(min-width: 1024px) 60vw, 92vw"
          format="webp"
          quality={75}
          loading="eager"
          decoding="async"
          class="sc-featured__img"
        />
      ) : (
        <div class="sc-featured__fallback" aria-hidden="true">
          <span class="sc-featured__fallback-index">{formattedOrdre}</span>
        </div>
      )}
      <div class="sc-featured__overlay" aria-hidden="true"></div>
    </div>

    <div class="sc-featured__content">
      <div class="sc-featured__badge">
        <span class="sc-featured__badge-dot" aria-hidden="true"></span>
        <span>Service {formattedOrdre}</span>
      </div>

      <h3 class="sc-featured__title">
        <a
          href={serviceHref(slug)}
          class="sc-featured__link after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange"
        >
          {title}
        </a>
      </h3>

      {accroche && (
        <p class="sc-featured__accroche">{accroche}</p>
      )}

      <div class="sc-featured__footer">
        <span class="sc-featured__cta">
          {linkLabel}
          <span class="sc-featured__cta-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" class="size-3.5">
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </span>
      </div>
    </div>
  </article>
) : (
  /* ── CARTE STANDARD HAUT DE GAMME ── */
  <article class={`sc-card group relative flex h-full w-full flex-col overflow-hidden rounded-2xl bg-blanc ${className}`}>
    {/* Zone Image */}
    <div class="sc-card__img-wrap">
      {image ? (
        <Image
          src={image.src}
          alt={image.alt}
          width={720}
          widths={[320, 480, 720]}
          sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
          format="webp"
          quality={72}
          loading="lazy"
          decoding="async"
          class="sc-card__img"
        />
      ) : (
        <div class="sc-card__fallback" aria-hidden="true">
          <span class="sc-card__fallback-index">{formattedOrdre}</span>
          <span class="sc-card__fallback-label">{shortLabel}</span>
        </div>
      )}

      {/* Tag flottant glassmorphic sur l'image */}
      <div class="sc-card__tag" aria-hidden="true">
        <span class="sc-card__tag-num">{formattedOrdre}</span>
        <span class="sc-card__tag-dot"></span>
        <span class="sc-card__tag-label">Sur cordes</span>
      </div>

      {/* Ligne d'accent supérieure au survol */}
      <div class="sc-card__accent-bar" aria-hidden="true"></div>
    </div>

    {/* Corps de la carte */}
    <div class="sc-card__body">
      <h3 class="sc-card__title">
        <a
          href={serviceHref(slug)}
          class="sc-card__link after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange"
        >
          {title}
        </a>
      </h3>

      {accroche ? (
        <p class="sc-card__accroche">{accroche}</p>
      ) : (
        <div class="flex-1" />
      )}

      {/* Pied de carte avec CTA interactif */}
      <div class="sc-card__footer">
        <span class="sc-card__cta-text">
          {linkLabel}
        </span>
        <span class="sc-card__cta-btn" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" class="sc-card__cta-arrow">
            <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>
    </div>
  </article>
)}

<style>
/* ─── CARTE VEDETTE ─────────────────────────────────────────────────────────── */
.sc-featured {
  position: relative;
  min-height: 440px;
  background: #1a2039;
  border: 1px solid oklch(100% 0 0 / 0.12);
  box-shadow: 0 8px 32px oklch(26% 0.07 260 / 0.12);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.sc-featured:hover {
  border-color: oklch(55% 0.22 40 / 0.3);
  box-shadow: 0 20px 48px oklch(26% 0.07 260 / 0.22);
  transform: translateY(-3px);
}

.sc-featured__img-wrap {
  position: absolute;
  inset: 0;
}

.sc-featured__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  transition: transform 6s ease-out;
}

.sc-featured:hover .sc-featured__img {
  transform: scale(1.05);
}

.sc-featured__fallback {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #232b4a 0%, #1a2039 100%);
  display: flex;
  align-items: flex-end;
  padding: 2rem;
}

.sc-featured__fallback-index {
  font-family: var(--font-display);
  font-size: 6rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: oklch(100% 0 0 / 0.06);
  line-height: 1;
}

.sc-featured__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    #1a2039 0%,
    oklch(14% 0.07 260 / 0.92) 35%,
    oklch(14% 0.07 260 / 0.45) 70%,
    transparent 100%
  );
}

.sc-featured__content {
  position: relative;
  margin-top: auto;
  padding: 2.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  z-index: 1;
}

.sc-featured__badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  background: oklch(100% 0 0 / 0.1);
  border: 1px solid oklch(100% 0 0 / 0.15);
  backdrop-filter: blur(8px);
  font-family: var(--font-display);
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #f96500;
  text-transform: uppercase;
  width: fit-content;
}

.sc-featured__badge-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #f96500;
}

.sc-featured__title {
  font-family: var(--font-display);
  font-size: clamp(1.375rem, 2.5vw, 1.875rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #ffffff;
  line-height: 1.15;
  text-wrap: balance;
  margin: 0;
}

.sc-featured__link {
  color: inherit;
  text-decoration: none;
}

.sc-featured__accroche {
  font-family: var(--font-sans);
  font-size: 0.9375rem;
  font-weight: 300;
  line-height: 1.65;
  color: oklch(100% 0 0 / 0.75);
  text-wrap: pretty;
  max-width: 46ch;
}

.sc-featured__footer {
  margin-top: 0.5rem;
}

.sc-featured__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  font-family: var(--font-display);
  font-size: 0.875rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: #ffffff;
  transition: all 0.2s ease;
}

.sc-featured:hover .sc-featured__cta {
  color: #f96500;
}

.sc-featured__cta-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #f96500;
  color: #1a2039;
  transition: transform 0.2s ease;
}

.sc-featured:hover .sc-featured__cta-icon {
  transform: translateX(4px);
}

/* ─── CARTE STANDARD ─────────────────────────────────────────────────────────── */
.sc-card {
  border: 1px solid oklch(26% 0.07 260 / 0.08);
  box-shadow: 0 4px 20px rgba(35, 43, 74, 0.04);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  background: #ffffff;
}

.sc-card:hover {
  border-color: oklch(55% 0.22 40 / 0.3);
  box-shadow: 0 16px 40px rgba(35, 43, 74, 0.1);
  transform: translateY(-3px);
}

.sc-card__img-wrap {
  position: relative;
  aspect-ratio: 16/10;
  overflow: hidden;
  background: #1a2039;
}

.sc-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 5s ease-out;
}

.sc-card:hover .sc-card__img {
  transform: scale(1.06);
}

.sc-card__fallback {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #232b4a 0%, #1a2039 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 1.25rem;
}

.sc-card__fallback-index {
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #f96500;
}

.sc-card__fallback-label {
  font-family: var(--font-display);
  font-size: 0.9375rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: oklch(100% 0 0 / 0.85);
  text-wrap: balance;
  max-width: 16ch;
  line-height: 1.25;
  text-transform: uppercase;
}

/* Tag glassmorphic sur l'image */
.sc-card__tag {
  position: absolute;
  top: 0.875rem;
  left: 0.875rem;
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.25rem 0.625rem;
  border-radius: 9999px;
  background: oklch(14% 0.07 260 / 0.82);
  border: 1px solid oklch(100% 0 0 / 0.18);
  backdrop-filter: blur(8px);
  z-index: 2;
}

.sc-card__tag-num {
  font-family: var(--font-display);
  font-size: 0.6875rem;
  font-weight: 800;
  color: #f96500;
}

.sc-card__tag-dot {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: oklch(100% 0 0 / 0.4);
}

.sc-card__tag-label {
  font-family: var(--font-display);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: oklch(100% 0 0 / 0.75);
}

.sc-card__accent-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(to right, #f96500, transparent);
  border-radius: 2px 2px 0 0;
  opacity: 0;
  transition: opacity 0.2s ease;
  z-index: 3;
}

.sc-card:hover .sc-card__accent-bar {
  opacity: 1;
}

.sc-card__body {
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
  padding: 1.5rem 1.625rem 1.5rem;
  flex: 1;
}

.sc-card__title {
  font-family: var(--font-display);
  font-size: 1.0625rem;
  font-weight: 800;
  letter-spacing: -0.015em;
  color: var(--color-navy);
  line-height: 1.3;
  text-wrap: balance;
  margin: 0;
}

.sc-card__link {
  color: inherit;
  text-decoration: none;
  transition: color 0.2s ease;
}

.sc-card:hover .sc-card__link {
  color: var(--color-orange-texte);
}

.sc-card__accroche {
  flex: 1;
  font-family: var(--font-sans);
  font-size: 0.875rem;
  font-weight: 300;
  line-height: 1.65;
  color: oklch(26% 0.07 260 / 0.7);
  text-wrap: pretty;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Pied de carte interactif */
.sc-card__footer {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid oklch(26% 0.07 260 / 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sc-card__cta-text {
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-navy);
  transition: color 0.2s ease;
}

.sc-card:hover .sc-card__cta-text {
  color: var(--color-orange-texte);
}

.sc-card__cta-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--color-gris);
  color: var(--color-navy);
  transition: all 0.2s ease;
}

.sc-card:hover .sc-card__cta-btn {
  background: #f96500;
  color: #1a2039;
  transform: translateX(3px);
}

.sc-card__cta-arrow {
  width: 12px;
  height: 12px;
}
</style>
