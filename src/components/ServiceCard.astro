---
import { Image } from 'astro:assets';
import { serviceHref } from '../lib/content.js';

/**
 * ServiceCard — Cadrage Parfait du Travailleur & Design Pro
 *
 * - Recadrage individualisé par prestation pour que le cordiste/travailleur soit TOUJOURS parfaitement visible et centré
 * - Photo 100% dégagée en haut (aucun pavé ne vient masquer l'artisan en action)
 * - Typographie contrastée et lien « Voir le service → » élégant
 *
 * Le badge « 01 · CORDISTES » posé sur l'image a été retiré le 14 août 2026 à
 * la demande du client. `ordre` ne sert donc plus qu'à la tuile de repli,
 * affichée quand la prestation n'a pas encore de photo.
 */

const { service, linkLabel = 'Voir le service', image, class: className = '' } = Astro.props;

const slug = service.slug;
const title = service.title ?? service.label;
const shortLabel = service.shortLabel ?? service.label ?? title;
const accroche = service.text ?? service.intro;
const ordre = service.ordre ?? 1;
const formattedOrdre = String(ordre).padStart(2, '0');

// Cadrages optimisés selon la position réelle du cordiste dans la photo de chantier
const CADRAGES = {
  'cheneaux-gouttieres': 'object-[center_85%]', // Les 2 cordistes suspendus sous la corniche
  'points-ancrage': 'object-[center_80%]',      // L'artisan au casque bleu en action
  'devegetalisation': 'object-[center_50%]',    // Le cordiste avec le seau d'intervention
  'maconnerie': 'object-[center_55%]',          // Le maçon cordiste sur façade
  'ravalement': 'object-[center_35%]',          // Les cordistes en hauteur sur la façade
  'couverture': 'object-[center_40%]',          // Le cordiste sur toiture en ardoise/zinc
  'nettoyage-vitres': 'object-[center_50%]',    // Le nettoyeur de vitres sur corde
  'filets-protection': 'object-[center_50%]',   // Pose de filet
  'pics-anti-pigeons': 'object-[center_50%]',   // Pose de pics
  'evenementiel': 'object-[center_35%]',        // Le cordiste sur structure scénique
};

const positionClass = CADRAGES[slug] ?? 'object-center';
---

<article class={`group relative flex h-full w-full flex-col overflow-hidden eleve rounded-carte bg-blanc ${className}`}>
  {/* Zone Photo avec cadrage focalisé sur le travailleur */}
  <div class="relative aspect-[16/11] w-full overflow-hidden bg-navy-profond">
    {image ? (
      <Image
        src={image.src}
        alt={image.alt}
        width={720}
        widths={[320, 480, 720]}
        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
        format="webp"
        quality={78}
        loading="lazy"
        decoding="async"
        class={`h-full w-full object-cover ${positionClass} transition-transform duration-500 ease-out group-hover:scale-105`}
      />
    ) : (
      <div class="flex h-full w-full flex-col justify-between bg-gradient-to-br from-navy to-navy-profond p-5" aria-hidden="true">
        <span class="font-display text-sm font-extrabold text-orange">
          {formattedOrdre}
        </span>
        <span class="font-display text-sm font-bold uppercase tracking-wider text-blanc/90 text-balance">
          {shortLabel}
        </span>
      </div>
    )}

  </div>

  {/* Corps de la carte (aucun bloc ne masque l'image au-dessus) */}
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <h3 class="font-display text-base sm:text-lg font-bold tracking-tight text-navy transition-colors duration-200 group-hover:text-orange text-balance leading-snug">
      <a
        href={serviceHref(slug)}
        class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange"
      >
        {title}
      </a>
    </h3>

    {accroche ? (
      <p class="mt-2.5 flex-1 text-sm font-light leading-relaxed text-navy/70 text-pretty line-clamp-3">
        {accroche}
      </p>
    ) : (
      <div class="flex-1" />
    )}

    {/* Lien d'action discret & pro */}
    <div class="mt-5 pt-3.5 border-t border-gris-bord flex items-center justify-between">
      <span class="inline-flex items-center gap-1.5 font-display text-[0.8125rem] font-bold tracking-tight text-navy underline-offset-4 decoration-orange decoration-2 transition-transform duration-200 group-hover:translate-x-1 group-hover:underline">
        <span>{linkLabel}</span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          class="shrink-0"
          aria-hidden="true"
        >
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </div>
</article>
