---
import { Image } from 'astro:assets';
import { serviceHref } from '../lib/content.js';

/**
 * ServiceCard — Design Sobre, Moderne & Professionnel (BTP Haut de Gamme)
 *
 * - Cadrage photo 16/10 propre avec zoom subtil au survol
 * - Badge de numéro/service discret
 * - Titre Montserrat net & accroche équilibrée
 * - Lien « Voir le service → » élégant et parfaitement proportionné
 */

const { service, linkLabel = 'Voir le service', image, class: className = '' } = Astro.props;

const slug = service.slug;
const title = service.title ?? service.label;
const shortLabel = service.shortLabel ?? service.label ?? title;
const accroche = service.text ?? service.intro;
const ordre = service.ordre ?? 1;
const formattedOrdre = String(ordre).padStart(2, '0');
---

<article class={`sc-card group relative flex h-full w-full flex-col overflow-hidden rounded-2xl bg-white border border-slate-200/80 shadow-sm transition-all duration-300 hover:shadow-xl hover:border-orange/30 hover:-translate-y-1 ${className}`}>
  {/* Zone Photo */}
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-navy-profond">
    {image ? (
      <Image
        src={image.src}
        alt={image.alt}
        width={720}
        widths={[320, 480, 720]}
        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
        format="webp"
        quality={75}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full w-full flex-col justify-between bg-gradient-to-br from-navy to-navy-profond p-5" aria-hidden="true">
        <span class="font-display text-sm font-extrabold text-orange">
          {formattedOrdre}
        </span>
        <span class="font-display text-sm font-bold uppercase tracking-wider text-white/90 text-balance">
          {shortLabel}
        </span>
      </div>
    )}

    {/* Badge discret sur l'image */}
    <div class="absolute left-3.5 top-3.5 flex items-center gap-1.5 rounded-full bg-navy-profond/70 px-2.5 py-1 text-[0.6875rem] font-bold uppercase tracking-wider text-white backdrop-blur-md border border-white/10" aria-hidden="true">
      <span class="text-orange">{formattedOrdre}</span>
      <span class="text-white/40">·</span>
      <span class="text-white/80">Cordistes</span>
    </div>
  </div>

  {/* Corps de la carte */}
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <h3 class="font-display text-base sm:text-lg font-bold tracking-tight text-navy transition-colors duration-200 group-hover:text-orange text-balance leading-snug">
      <a
        href={serviceHref(slug)}
        class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange"
      >
        {title}
      </a>
    </h3>

    {accroche ? (
      <p class="mt-2.5 flex-1 text-sm font-light leading-relaxed text-navy/70 text-pretty line-clamp-3">
        {accroche}
      </p>
    ) : (
      <div class="flex-1" />
    )}

    {/* Lien d'action discret & pro */}
    <div class="mt-5 pt-3.5 border-t border-slate-100 flex items-center justify-between">
      <span class="inline-flex items-center gap-1.5 font-display text-[0.8125rem] font-bold tracking-tight text-navy transition-colors duration-200 group-hover:text-orange">
        <span>{linkLabel}</span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="shrink-0 transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true"
        >
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </div>
</article>
