---
import { Image } from 'astro:assets';
import { serviceHref } from '../lib/content.js';

/**
 * Carte service — image, titre, accroche, lien.
 *
 * Toute la carte est cliquable via l'extension du lien du titre (::after) :
 * une seule cible pour les lecteurs d'écran, une grande zone tactile au doigt.
 *
 * Plus de bordure : la carte tient par son ombre et son fond blanc. Au survol
 * elle monte de 3 px, l'ombre s'élargit et la photo zoome lentement — les
 * trois se déclenchent ensemble, sur la même durée.
 *
 * `image` est facultatif : les photos de chantier ne sont pas toutes triées.
 * En son absence, une tuile navy tient la place sans casser la grille.
 */

const { service, linkLabel = 'Voir le service', image, class: className = '' } = Astro.props;

// Tolère les deux formes : une entrée de la collection `services` (title,
// shortLabel, intro) et une carte de l'accueil (label, text).
const slug = service.slug;
const title = service.title ?? service.label;
const shortLabel = service.shortLabel ?? service.label ?? title;
const accroche = service.text ?? service.intro;
const ordre = service.ordre;
---

<article
  class={`eleve group relative flex h-full flex-col overflow-hidden rounded-carte bg-blanc ${className}`}
  data-reveal
>
  <div class="photo photo-zoom relative aspect-[4/3]">
    {
      image ? (
        <Image
          src={image.src}
          alt={image.alt}
          width={720}
          widths={[320, 480, 720]}
          sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
          format="webp"
          quality={68}
          loading="lazy"
          decoding="async"
        />
      ) : (
        /*
          Pas encore de photo : plutôt qu'un cadre gris qui se lit comme une
          image cassée, une tuile navy assumée — index, nom du service en
          capitales. Ça ressemble à une fiche technique, pas à un gabarit
          inachevé.
        */
        <div
          class="flex h-full w-full flex-col justify-between bg-navy p-5"
          aria-hidden="true"
        >
          <span class="font-display text-etiquette text-orange">
            {String(ordre ?? 0).padStart(2, '0')}
          </span>
          <span class="max-w-[16ch] font-display text-[0.9375rem] font-bold uppercase leading-tight tracking-[0.08em] text-blanc/85 text-balance">
            {shortLabel}
          </span>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-3 p-6 sm:p-7">
    <h3 class="text-carte text-navy text-balance">
      <a
        href={serviceHref(slug)}
        class="rounded-[2px] after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange"
      >
        {title}
      </a>
    </h3>

    {
      accroche ? (
        <p class="flex-1 text-petit font-light text-navy/75 text-pretty">{accroche}</p>
      ) : (
        <div class="flex-1" />
      )
    }

    <span
      class="mt-1 inline-flex items-center gap-2 font-display text-[0.9375rem] font-bold tracking-tight text-navy transition-colors duration-200 group-hover:text-orange"
    >
      {linkLabel}
      <svg
        aria-hidden="true"
        viewBox="0 0 16 16"
        class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</article>
