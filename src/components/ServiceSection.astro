---
import InfoBox from './InfoBox.astro';
import Gallery from './Gallery.astro';
import CtaBand from './CtaBand.astro';
import TitreSection from './TitreSection.astro';
import TuileIcone from './TuileIcone.astro';

/**
 * Rend UNE section de page service selon son `type`.
 *
 * Toute la mise en forme des blocs 2 à 9 vit ici : le template [slug].astro se
 * contente de boucler. Ajouter un type de section = ajouter un `case`, sans
 * toucher au template ni aux neuf fichiers de contenu.
 *
 * RYTHME — chaque type a sa propre mise en page ET son propre fond, de sorte
 * qu'en descendant la page on ne rencontre jamais deux fois la même structure :
 *
 *   keyFacts    carte grise posée              fond blanc
 *   expertise   deux colonnes asymétriques 5/7 fond blanc
 *   process     grille décalée, 4 étapes       fond gris
 *   audiences   deux colonnes de cartes        fond blanc
 *   zones       colonne unique, mesure courte  fond navy plein
 *   realisations galerie pleine largeur        photos
 *   cta         bandeau                        fond navy profond
 *
 * C'est l'alternance qui porte la hiérarchie, plus le filet orange répété en
 * tête de chaque bloc — il ne subsiste que sous forme de corde verticale.
 */

const { section, photos = [], shortLabel, ordre } = Astro.props;
---

{/* 2. Infos clés — remonte contre le hero, sans respiration avant */}
{
  section.type === 'keyFacts' && (
    <div class="mx-auto max-w-6xl px-5 pb-4 pt-12 sm:px-8 sm:pt-16">
      <InfoBox items={section.items} title="Infos clés" />
    </div>
  )
}

{/* 3. Notre expertise — deux colonnes asymétriques : le titre tient seul à
    gauche, la matière défile à droite. */}
{
  section.type === 'expertise' && (
    <section class="mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8" data-reveal>
      <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <div class="corde corde-descend lg:sticky lg:top-28">
            <TitreSection texte={section.title} />
            <p class="mt-6 max-w-[46ch] text-corps font-light text-navy/75 text-pretty">
              {section.intro}
            </p>
          </div>
        </div>

        <ul class="grid gap-8 lg:col-span-7">
          {section.items.map((item) => (
            <li class="rounded-carte bg-blanc p-6 shadow-repos sm:p-7">
              <h3 class="text-carte text-navy text-balance">{item.label}</h3>
              <p class="mt-3 max-w-[54ch] text-petit font-light text-navy/75 text-pretty">
                {item.text}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

{/* 4. Comment ça marche — grille décalée : une étape sur deux descend d'un
    demi-pas sur écran large, la lecture cesse d'être une rangée de cases. */}
{
  section.type === 'process' && (
    <section class="bg-gris" data-reveal>
      <div class="mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8">
        <TitreSection texte={section.title} class="max-w-[20ch]" />

        <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {section.steps.map((step, i) => (
            <li
              class={`eleve rounded-carte bg-blanc p-6 ${i % 2 === 1 ? 'lg:mt-10' : ''}`}
            >
              <TuileIcone variant={i === 0 ? 'orange' : 'navy'} taille="sm">
                <span class="font-display text-[0.8125rem] font-bold">{i + 1}</span>
              </TuileIcone>
              <p class="mt-5 font-display text-etiquette uppercase text-navy/70">{step.step}</p>
              <h3 class="mt-2 text-carte text-navy text-balance">{step.label}</h3>
              <p class="mt-3 text-petit font-light text-navy/75 text-pretty">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

{/* 5. Adapté à vos enjeux — cartes flottantes, plus de grille en grillage */}
{
  section.type === 'audiences' && (
    <section class="mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8" data-reveal>
      <TitreSection texte={section.title} class="max-w-[20ch]" />

      <ul class="mt-12 grid gap-6 sm:grid-cols-2">
        {section.items.map((item) => (
          <li class="eleve rounded-carte bg-blanc p-7 sm:p-8">
            <h3 class="text-carte text-navy text-balance">{item.label}</h3>
            <p class="mt-3 text-petit font-light text-navy/75 text-pretty">{item.text}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}

{/* 6. Zones d'intervention — aplat navy, colonne unique, mesure courte.
    C'est la respiration sombre au milieu de la page. */}
{
  section.type === 'zones' && (
    <section class="relative overflow-hidden bg-navy" data-reveal>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -right-24 top-1/2 size-[28rem] -translate-y-1/2 rounded-full bg-orange/10 blur-3xl"
      />
      <div class="relative mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8">
        <div class="corde max-w-[60ch]">
          <TitreSection texte={section.title} ton="clair" />
          {section.paragraphs.map((paragraphe) => (
            <p class="mt-6 text-corps-large font-light text-blanc/80 text-pretty">
              {paragraphe}
            </p>
          ))}
        </div>
      </div>
    </section>
  )
}

{/* 7. Réalisations — ne rend rien tant que src/assets/photos/{slug}/ est vide */}
{
  section.type === 'realisations' && (
    <Gallery photos={photos} title={section.title} shortLabel={shortLabel} ordre={ordre} />
  )
}

{/* 9. Bloc d'appel final */}
{
  section.type === 'cta' && (
    <CtaBand title={section.title} text={section.text} buttons={section.buttons} />
  )
}
