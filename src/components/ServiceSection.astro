---
import InfoBox from './InfoBox.astro';
import Gallery from './Gallery.astro';
import CtaBand from './CtaBand.astro';

/**
 * Rend UNE section de page service selon son `type`.
 *
 * Toute la mise en forme des blocs 2 à 9 vit ici : le template [slug].astro se
 * contente de boucler. Ajouter un type de section = ajouter un `case`, sans
 * toucher au template ni aux neuf fichiers de contenu.
 */

const { section, photos = [], shortLabel, ordre } = Astro.props;
---

{/* 2. Infos clés */}
{
  section.type === 'keyFacts' && (
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <InfoBox items={section.items} title="Infos clés" />
    </div>
  )
}

{/* 3. Notre expertise */}
{
  section.type === 'expertise' && (
    <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20" data-reveal>
      <h2 class="border-l-2 border-orange pl-5 text-2xl font-bold leading-tight tracking-tight text-navy text-balance sm:text-3xl">
        {section.title}
      </h2>
      <p class="mt-6 max-w-[68ch] text-base leading-relaxed text-navy/75 text-pretty">
        {section.intro}
      </p>

      <ul class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {section.items.map((item) => (
          <li class="border-t border-navy/12 pt-5">
            <h3 class="text-lg font-bold leading-snug tracking-tight text-navy text-balance">
              {item.label}
            </h3>
            <p class="mt-2.5 max-w-[52ch] text-[0.9375rem] leading-relaxed text-navy/75 text-pretty">
              {item.text}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )
}

{/* 4. Comment ça marche — le fil orange coiffe chaque étape */}
{
  section.type === 'process' && (
    <section class="bg-gris" data-reveal>
      <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
        <h2 class="border-l-2 border-orange pl-5 text-2xl font-bold leading-tight tracking-tight text-navy text-balance sm:text-3xl">
          {section.title}
        </h2>

        <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
          {section.steps.map((step) => (
            <li>
              <span aria-hidden="true" class="mb-5 block h-1 w-9 bg-orange" />
              <p class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-navy/50">
                {step.step}
              </p>
              <h3 class="mt-2 text-lg font-bold leading-snug tracking-tight text-navy text-balance">
                {step.label}
              </h3>
              <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-navy/75 text-pretty">
                {step.text}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

{/* 5. Adapté à vos enjeux */}
{
  section.type === 'audiences' && (
    <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20" data-reveal>
      <h2 class="border-l-2 border-orange pl-5 text-2xl font-bold leading-tight tracking-tight text-navy text-balance sm:text-3xl">
        {section.title}
      </h2>

      <ul class="mt-10 grid gap-px border border-navy/12 bg-navy/12 sm:grid-cols-2">
        {section.items.map((item) => (
          <li class="bg-blanc p-6 sm:p-8">
            <h3 class="text-lg font-bold leading-snug tracking-tight text-navy text-balance">
              {item.label}
            </h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-navy/75 text-pretty">
              {item.text}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )
}

{/* 6. Zones d'intervention */}
{
  section.type === 'zones' && (
    <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20" data-reveal>
      <div class="max-w-[68ch] border-l-2 border-orange pl-5 sm:pl-7">
        <h2 class="text-2xl font-bold leading-tight tracking-tight text-navy text-balance sm:text-3xl">
          {section.title}
        </h2>
        {section.paragraphs.map((paragraphe) => (
          <p class="mt-5 text-base leading-relaxed text-navy/75 text-pretty">{paragraphe}</p>
        ))}
      </div>
    </section>
  )
}

{/* 7. Réalisations — ne rend rien tant que _sources/photos/{slug}/ est vide */}
{
  section.type === 'realisations' && (
    <Gallery photos={photos} title={section.title} shortLabel={shortLabel} ordre={ordre} />
  )
}

{/* 9. Bloc d'appel final */}
{
  section.type === 'cta' && (
    <CtaBand title={section.title} text={section.text} buttons={section.buttons} />
  )
}
