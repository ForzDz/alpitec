---
/**
 * InfoBox — Encadré "Infos clés" premium
 * Design glassmorphic avec grille de données élégante
 */

const { items, title, class: className = '' } = Astro.props;
---

<aside
  class={`infobox ${className}`}
  aria-label={title ?? 'Informations clés'}
  data-reveal
>
  {title && (
    <p class="infobox__label">{title}</p>
  )}

  <dl class="infobox__grid">
    {items.map((item) => (
      <div class="infobox__item">
        <dt class="infobox__dt">{item.label}</dt>
        <dd class="infobox__dd">{item.text}</dd>
      </div>
    ))}
  </dl>
</aside>

<style>
.infobox {
  position: relative;
  border-radius: var(--radius-bloc);
  background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-profond) 100%);
  border: 1px solid color-mix(in srgb, var(--color-blanc) 10%, transparent);
  padding: 1.75rem 2rem;
  overflow: hidden;
  box-shadow: 0 8px 40px color-mix(in srgb, var(--color-navy) 15%, transparent);
}

.infobox::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, color-mix(in srgb, var(--color-orange) 6%, transparent) 0%, transparent 60%);
  pointer-events: none;
}

.infobox::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(to right, transparent, color-mix(in srgb, var(--color-blanc) 15%, transparent), transparent);
}

.infobox__label {
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 700;
  letter-spacing: var(--text-etiquette--letter-spacing);
  text-transform: uppercase;
  color: var(--color-blanc);
  margin-bottom: 1.25rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.infobox__label::before {
  content: '';
  display: block;
  width: 16px;
  height: 2px;
  background: var(--color-orange);
  border-radius: 1px;
}

.infobox__grid {
  display: grid;
  gap: 0;
  grid-template-columns: 1fr;
}

@media (min-width: 640px) {
  .infobox__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .infobox__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.infobox__item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 1rem 1.25rem;
  border-left: 1px solid color-mix(in srgb, var(--color-blanc) 8%, transparent);
  position: relative;
}

.infobox__item:first-child {
  border-left: none;
}

@media (max-width: 639px) {
  .infobox__item {
    border-left: none;
    border-top: 1px solid color-mix(in srgb, var(--color-blanc) 8%, transparent);
    padding: 0.875rem 0;
  }

  .infobox__item:first-child {
    border-top: none;
    padding-top: 0;
  }
}

@media (min-width: 640px) and (max-width: 1023px) {
  .infobox__item:nth-child(1),
  .infobox__item:nth-child(2) {
    border-top: none;
    padding-top: 0;
  }
  .infobox__item:nth-child(2n+1) {
    border-left: none;
  }
}

.infobox__dt {
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--color-blanc) 70%, transparent);
  line-height: 1;
}

.infobox__dd {
  font-family: var(--font-display);
  font-size: var(--text-petit);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--color-blanc);
  line-height: 1.35;
  text-wrap: balance;
}
</style>
