---
import Button from './Button.astro';

/**
 * InfoBox — bloc « Infos clés » posé en tête de chaque page service.
 *
 * Refondu le 16 août 2026 à la demande du client, qui voulait le niveau de
 * détail d'un concurrent : on passe d'une grille de quatre données sèches à
 * une liste cochée de cinq engagements, fermée par un bouton de devis.
 *
 * Chaque ligne porte une coche en `--color-succes`. Ce vert est RÉSERVÉ AUX
 * FONDS NAVY — 5,8:1 ici, mais 2,1:1 sur blanc. Voir le commentaire du jeton
 * dans global.css avant de le réemployer ailleurs.
 *
 * La coche est décorative : elle répète visuellement ce que la liste dit déjà.
 * Elle est donc `aria-hidden`, et l'information reste portée par le couple
 * <dt>/<dd> — un lecteur d'écran n'entend pas « coche » cinq fois.
 */

const { items, title, class: className = '', devisHref = '#devis' } = Astro.props;
---

<aside
  class={`infobox ${className}`}
  aria-label={title ?? 'Informations clés'}
  data-reveal
>
  {title && (
    <p class="infobox__label">{title}</p>
  )}

  <dl class="infobox__grid">
    {items.map((item) => (
      <div class="infobox__item">
        <span class="infobox__coche" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 8.5l3.5 3.5L13 5" />
          </svg>
        </span>
        <div class="infobox__texte">
          <dt class="infobox__dt">{item.label}</dt>
          <dd class="infobox__dd">{item.text}</dd>
        </div>
      </div>
    ))}
  </dl>

  <div class="infobox__pied">
    <Button href={devisHref} variant="primaire" size="md" data-cta="devis-infobox">
      Demander un devis
    </Button>
  </div>
</aside>

<style>
.infobox {
  position: relative;
  border-radius: var(--radius-bloc);
  background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-profond) 100%);
  border: 1px solid color-mix(in srgb, var(--color-blanc) 10%, transparent);
  padding: 1.75rem 2rem;
  overflow: hidden;
  box-shadow: 0 8px 40px color-mix(in srgb, var(--color-navy) 15%, transparent);
}

.infobox::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, color-mix(in srgb, var(--color-orange) 6%, transparent) 0%, transparent 60%);
  pointer-events: none;
}

.infobox::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(to right, transparent, color-mix(in srgb, var(--color-blanc) 15%, transparent), transparent);
}

.infobox__label {
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 700;
  letter-spacing: var(--text-etiquette--letter-spacing);
  text-transform: uppercase;
  color: var(--color-blanc);
  margin-bottom: 1.25rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.infobox__label::before {
  content: '';
  display: block;
  width: 16px;
  height: 2px;
  background: var(--color-orange);
  border-radius: 1px;
}

/* Liste cochée : une colonne au doigt, deux dès qu'il y a la place. Les
   engagements se lisent l'un sous l'autre, pas comme un tableau de bord. */
.infobox__grid {
  position: relative;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.875rem 2rem;
}

@media (min-width: 48rem) {
  .infobox__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.infobox__item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  min-width: 0;
}

.infobox__coche {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 1.25rem;
  height: 1.25rem;
  margin-top: 0.0625rem;
  border-radius: var(--radius-tuile);
  background: color-mix(in srgb, var(--color-succes) 16%, transparent);
  color: var(--color-succes);
}

.infobox__coche svg {
  width: 0.75rem;
  height: 0.75rem;
}

.infobox__texte {
  min-width: 0;
}

.infobox__dt {
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--color-blanc) 70%, transparent);
  line-height: 1.3;
}

.infobox__dd {
  font-family: var(--font-display);
  font-size: var(--text-petit);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--color-blanc);
  line-height: 1.35;
  text-wrap: balance;
}

.infobox__pied {
  position: relative;
  margin-top: 1.5rem;
  padding-top: 1.25rem;
  border-top: 1px solid color-mix(in srgb, var(--color-blanc) 12%, transparent);
}

@media (max-width: 47.99rem) {
  .infobox__pied :global(a) {
    width: 100%;
  }
}
</style>
