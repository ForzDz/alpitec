---
/**
 * Encadré « Infos clés » — zone d'intervention, devis, certifications, assurance.
 *
 * Alimenté par la section `keyFacts` des fichiers services. Le fil orange court
 * sur le bord gauche : c'est la corde, motif structurant de tout le site.
 */

const { items, title, class: className = '' } = Astro.props;
---

<aside
  class={`relative bg-gris border-l-2 border-orange px-6 py-7 sm:px-8 sm:py-8 ${className}`}
  aria-label={title ?? 'Informations clés'}
  data-reveal
>
  {
    title && (
      <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-navy/55 mb-6">
        {title}
      </h2>
    )
  }

  <dl class="grid gap-x-10 gap-y-5 sm:grid-cols-2">
    {
      items.map((item) => (
        <div class="flex flex-col gap-1">
          <dt class="text-xs font-bold uppercase tracking-[0.12em] text-navy/55">
            {item.label}
          </dt>
          <dd class="text-[0.9375rem] font-bold leading-snug text-navy text-balance">
            {item.text}
          </dd>
        </div>
      ))
    }
  </dl>
</aside>
