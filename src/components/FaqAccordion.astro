---
/**
 * Accordéon FAQ — accessible et sans dépendance.
 *
 * Accessibilité :
 *   · l'en-tête est un <button> dans un <h3> (navigable au clavier nativement)
 *   · aria-expanded reflète l'état, aria-controls pointe le panneau
 *   · le panneau porte role="region" et aria-labelledby
 *   · flèches haut/bas, Début et Fin déplacent le focus entre questions
 *
 * SEO : les réponses sont TOUJOURS dans le DOM (masquées par `hidden`), jamais
 * injectées en JavaScript. Sans JS, tous les panneaux restent ouverts.
 */

const { items, title, id = 'faq' } = Astro.props;
---

<section class="scroll-mt-28" aria-labelledby={`${id}-titre`} data-reveal>
  {
    title && (
      <h2
        id={`${id}-titre`}
        class="relative mb-10 border-l-2 border-orange pl-5 text-2xl font-bold leading-tight tracking-tight text-navy text-balance sm:text-3xl"
      >
        {title}
      </h2>
    )
  }

  <div class="border-t border-navy/12" data-faq>
    {
      items.map((item, i) => (
        <div class="border-b border-navy/12">
          <h3 class="m-0">
            <button
              type="button"
              id={`${id}-q-${i}`}
              class="group flex w-full items-start justify-between gap-6 py-5 text-left transition-colors duration-150 hover:text-orange focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange sm:py-6"
              aria-expanded="false"
              aria-controls={`${id}-r-${i}`}
              data-faq-trigger
            >
              <span class="text-base font-bold leading-snug tracking-tight text-balance sm:text-lg">
                {item.question}
              </span>
              <svg
                aria-hidden="true"
                viewBox="0 0 16 16"
                class="mt-1 h-4 w-4 shrink-0 text-orange transition-transform duration-200 ease-out group-aria-expanded:rotate-45"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M8 2v12M2 8h12" stroke-linecap="square" />
              </svg>
            </button>
          </h3>

          <div
            id={`${id}-r-${i}`}
            role="region"
            aria-labelledby={`${id}-q-${i}`}
            data-faq-panel
          >
            <p class="max-w-[68ch] pb-6 pr-10 text-[0.9375rem] leading-relaxed text-navy/75 text-pretty sm:pb-7">
              {item.answer}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Progressive enhancement : sans JS les panneaux restent visibles et lisibles.
  for (const faq of document.querySelectorAll('[data-faq]')) {
    const triggers = [...faq.querySelectorAll('[data-faq-trigger]')];

    for (const trigger of triggers) {
      const panel = document.getElementById(trigger.getAttribute('aria-controls'));
      panel.hidden = true;

      trigger.addEventListener('click', () => {
        const ouvert = trigger.getAttribute('aria-expanded') === 'true';
        trigger.setAttribute('aria-expanded', String(!ouvert));
        panel.hidden = ouvert;
      });

      trigger.addEventListener('keydown', (e) => {
        const i = triggers.indexOf(trigger);
        const cibles = {
          ArrowDown: triggers[(i + 1) % triggers.length],
          ArrowUp: triggers[(i - 1 + triggers.length) % triggers.length],
          Home: triggers[0],
          End: triggers[triggers.length - 1],
        };
        const cible = cibles[e.key];
        if (cible) {
          e.preventDefault();
          cible.focus();
        }
      });
    }
  }
</script>
