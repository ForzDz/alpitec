---
import TitreSection from './TitreSection.astro';

/**
 * Accordéon FAQ — accessible et sans dépendance.
 *
 * Accessibilité :
 *   · l'en-tête est un <button> dans un <h3> (navigable au clavier nativement)
 *   · aria-expanded reflète l'état, aria-controls pointe le panneau
 *   · le panneau porte role="region" et aria-labelledby
 *   · flèches haut/bas, Début et Fin déplacent le focus entre questions
 *
 * SEO : les réponses sont TOUJOURS dans le DOM (masquées par `hidden`), jamais
 * injectées en JavaScript. Sans JS, tous les panneaux restent ouverts.
 */

const { items, title, id = 'faq' } = Astro.props;
---

<section class="scroll-mt-28" aria-labelledby={`${id}-titre`} data-reveal>
  {
    title && (
      <TitreSection texte={title} id={`${id}-titre`} class="mb-12 max-w-[20ch]" data-reveal="titre" />
    )
  }

  {/*
    Une carte par question plutôt qu'une pile séparée par des filets : ouverte,
    la carte se détache du fond au lieu de dilater une ligne de tableau.
  */}
  <div class="grid gap-3" data-faq data-reveal-groupe>
    {
      items.map((item, i) => (
        <div class="overflow-hidden rounded-carte bg-blanc shadow-repos transition-shadow duration-200 has-[[aria-expanded='true']]:shadow-flottant">
          <h3 class="m-0">
            <button
              type="button"
              id={`${id}-q-${i}`}
              class="group flex w-full items-start justify-between gap-6 px-5 py-5 text-left transition-colors duration-200 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-orange sm:px-7 sm:py-6"
              aria-expanded="false"
              aria-controls={`${id}-r-${i}`}
              data-faq-trigger
            >
              <span class="font-display text-base font-bold leading-snug tracking-tight text-balance sm:text-lg">
                {item.question}
              </span>
              <span
                aria-hidden="true"
                class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-tuile bg-gris text-navy transition-colors duration-200 group-hover:bg-orange group-aria-expanded:bg-navy group-aria-expanded:text-blanc"
              >
                <svg
                  viewBox="0 0 16 16"
                  class="size-3.5 transition-transform duration-200 ease-out group-aria-expanded:rotate-45"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path d="M8 2v12M2 8h12" stroke-linecap="round" />
                </svg>
              </span>
            </button>
          </h3>

          <div
            id={`${id}-r-${i}`}
            role="region"
            aria-labelledby={`${id}-q-${i}`}
            data-faq-panel
          >
            <p class="max-w-[68ch] px-5 pb-6 text-petit font-light text-navy/75 text-pretty sm:px-7 sm:pb-7">
              {item.answer}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Progressive enhancement : sans JS les panneaux restent visibles et lisibles.
  for (const faq of document.querySelectorAll('[data-faq]')) {
    const triggers = [...faq.querySelectorAll('[data-faq-trigger]')];

    for (const trigger of triggers) {
      const panel = document.getElementById(trigger.getAttribute('aria-controls'));
      panel.hidden = true;

      trigger.addEventListener('click', () => {
        const ouvert = trigger.getAttribute('aria-expanded') === 'true';
        trigger.setAttribute('aria-expanded', String(!ouvert));
        panel.hidden = ouvert;
      });

      trigger.addEventListener('keydown', (e) => {
        const i = triggers.indexOf(trigger);
        const cibles = {
          ArrowDown: triggers[(i + 1) % triggers.length],
          ArrowUp: triggers[(i - 1 + triggers.length) % triggers.length],
          Home: triggers[0],
          End: triggers[triggers.length - 1],
        };
        const cible = cibles[e.key];
        if (cible) {
          e.preventDefault();
          cible.focus();
        }
      });
    }
  }
</script>
