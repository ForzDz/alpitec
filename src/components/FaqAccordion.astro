---
import TitreSection from './TitreSection.astro';

/**
 * FaqAccordion — Design premium avec cartes à expansion douce
 *
 * Accessibilité :
 *   · button dans h3, aria-expanded, aria-controls
 *   · panneau role="region" avec aria-labelledby
 *   · navigation clavier (flèches haut/bas, Début/Fin)
 *
 * SEO : réponses toujours dans le DOM (hidden), jamais injectées en JS.
 */

const { items, title, id = 'faq' } = Astro.props;
---

<section class="faq-section scroll-mt-28" aria-labelledby={`${id}-titre`} data-reveal>
  {title && (
    <div class="faq-section__header">
      <div class="faq-section__eyebrow">
        <span class="faq-section__eyebrow-line" aria-hidden="true"></span>
        Questions fréquentes
      </div>
      <TitreSection texte={title} id={`${id}-titre`} class="faq-section__title" data-reveal="titre" />
    </div>
  )}

  <div class="faq-section__grid" data-faq data-reveal-groupe>
    {items.map((item, i) => (
      <div class="faq-card">
        <h3 class="faq-card__heading">
          <button
            type="button"
            id={`${id}-q-${i}`}
            class="faq-card__trigger"
            aria-expanded="false"
            aria-controls={`${id}-r-${i}`}
            data-faq-trigger
          >
            <span class="faq-card__question">{item.question}</span>

            {/* Toggle icon */}
            <span class="faq-card__toggle" aria-hidden="true">
              <svg
                viewBox="0 0 16 16"
                class="faq-card__toggle-icon"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M8 2v12M2 8h12" stroke-linecap="round" />
              </svg>
            </span>
          </button>
        </h3>

        <div
          id={`${id}-r-${i}`}
          role="region"
          aria-labelledby={`${id}-q-${i}`}
          data-faq-panel
        >
          <p class="faq-card__answer">{item.answer}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
/* ─── FAQ Section ────────────────────────────────────────────────────────────── */
.faq-section {
  /* Styles propres à cette section */
}

.faq-section__header {
  margin-bottom: 2.5rem;
}

.faq-section__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-display);
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-orange-texte);
  margin-bottom: 1rem;
}

.faq-section__eyebrow-line {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--color-orange);
  border-radius: 1px;
}

.faq-section__title {
  max-width: 22ch;
}

.faq-section__grid {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

/* ─── FAQ Card ───────────────────────────────────────────────────────────────── */
.faq-card {
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid oklch(26% 0.07 260 / 0.08);
  overflow: hidden;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.faq-card:has([aria-expanded='true']) {
  border-color: oklch(55% 0.22 40 / 0.2);
  box-shadow: 0 4px 24px oklch(26% 0.07 260 / 0.08);
}

.faq-card__heading {
  margin: 0;
}

.faq-card__trigger {
  display: flex;
  width: 100%;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 1.25rem 1.5rem;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
  transition: background-color 0.15s ease;
}

.faq-card__trigger:hover {
  background: oklch(26% 0.07 260 / 0.02);
}

.faq-card__trigger:focus-visible {
  outline: 2px solid var(--color-orange);
  outline-offset: -2px;
}

.faq-card__question {
  font-family: var(--font-display);
  font-size: clamp(0.9375rem, 1.6vw, 1.0625rem);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--color-navy);
  line-height: 1.4;
  text-wrap: balance;
}

/* Toggle */
.faq-card__toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: var(--color-gris);
  color: var(--color-navy);
  flex-shrink: 0;
  margin-top: 1px;
  transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

.faq-card__trigger:hover .faq-card__toggle {
  background: oklch(55% 0.22 40 / 0.12);
  color: var(--color-orange-texte);
}

.faq-card__trigger[aria-expanded='true'] .faq-card__toggle {
  background: var(--color-navy);
  color: #ffffff;
  transform: rotate(45deg);
}

.faq-card__toggle-icon {
  width: 12px;
  height: 12px;
}

/* Answer panel */
.faq-card__answer {
  padding: 0 1.5rem 1.25rem;
  font-family: var(--font-sans);
  font-size: 0.9375rem;
  font-weight: 300;
  line-height: 1.7;
  color: oklch(26% 0.07 260 / 0.65);
  text-wrap: pretty;
  max-width: 64ch;
}
</style>

<script>
  // Progressive enhancement : sans JS les panneaux restent visibles et lisibles.
  for (const faq of document.querySelectorAll('[data-faq]')) {
    const triggers = [...faq.querySelectorAll('[data-faq-trigger]')];

    for (const trigger of triggers) {
      const panel = document.getElementById(trigger.getAttribute('aria-controls'));
      panel.hidden = true;

      trigger.addEventListener('click', () => {
        const ouvert = trigger.getAttribute('aria-expanded') === 'true';
        trigger.setAttribute('aria-expanded', String(!ouvert));
        panel.hidden = ouvert;
      });

      trigger.addEventListener('keydown', (e) => {
        const i = triggers.indexOf(trigger);
        const cibles = {
          ArrowDown: triggers[(i + 1) % triggers.length],
          ArrowUp: triggers[(i - 1 + triggers.length) % triggers.length],
          Home: triggers[0],
          End: triggers[triggers.length - 1],
        };
        const cible = cibles[e.key];
        if (cible) {
          e.preventDefault();
          cible.focus();
        }
      });
    }
  }
</script>
