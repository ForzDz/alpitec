---
/**
 * Fil d'Ariane.
 *
 * `items` : [{ label, href }] — le dernier élément est la page courante et
 * n'est pas cliquable (aria-current="page").
 *
 * `ton` : « sombre » sur fond clair, « clair » sur un aplat navy.
 *
 * Le JSON-LD BreadcrumbList correspondant est généré par la page, à partir de
 * la même liste : les deux ne peuvent pas diverger.
 *
 * Les liens portent `-my-3 py-3` : 44 px de zone tactile au doigt, sans
 * modifier la hauteur visuelle du fil.
 */

const { items, ton = 'sombre', class: className = '' } = Astro.props;

const clair = ton === 'clair';

/*
 * Sur navy, l'orange de marque atteint 4,5:1 et peut donc servir au survol.
 * Sur fond clair il plafonne à 3,9:1 même assombri : le survol y passe par un
 * soulignement, jamais par la couleur. C'est la règle du site.
 */
const couleurs = clair
  ? {
      liste: 'text-blanc/70',
      lien: 'hover:text-orange',
      courant: 'font-bold text-blanc',
      separateur: 'text-blanc/70',
    }
  : {
      liste: 'text-navy/70',
      lien: 'underline-offset-4 decoration-orange decoration-2 hover:underline',
      courant: 'font-bold text-navy',
      separateur: 'text-navy/70',
    };
---

<nav aria-label="Fil d'Ariane" class={className}>
  <ol class={`flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.8125rem] ${couleurs.liste}`}>
    {
      items.map((item, i) => {
        const dernier = i === items.length - 1;
        return (
          <li class="flex items-center gap-2">
            {/*
              Le séparateur ne descend pas sous 70 % d'opacité : c'est du texte
              à l'écran, et /25 tombait à 1,6:1. Le poids visuel est rattrapé
              par la graisse légère, pas par la transparence.
            */}
            {i > 0 && (
              <span aria-hidden="true" class={`font-light ${couleurs.separateur}`}>
                /
              </span>
            )}
            {dernier ? (
              <span aria-current="page" class={couleurs.courant}>
                {item.label}
              </span>
            ) : (
              <a
                href={item.href}
                class={`-my-3 inline-flex min-h-11 items-center py-3 transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange ${couleurs.lien}`}
              >
                {item.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
