---
/**
 * Fil d'Ariane.
 *
 * `items` : [{ label, href }] — le dernier élément est la page courante et
 * n'est pas cliquable (aria-current="page").
 *
 * Le JSON-LD BreadcrumbList correspondant est généré par la page, à partir de
 * la même liste : les deux ne peuvent pas diverger.
 *
 * Les liens portent `-my-3 py-3` : 44 px de zone tactile au doigt, sans
 * modifier la hauteur visuelle du fil.
 */

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class={className}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.8125rem] text-navy/70">
    {
      items.map((item, i) => {
        const dernier = i === items.length - 1;
        return (
          <li class="flex items-center gap-2">
            {/*
              Séparateur en `navy/70` et non `navy/25` : il reste du texte à
              l'écran, et la règle du site ne descend pas en dessous de 70 %
              — /25 tombait à 1,6:1. Le poids visuel est rattrapé par la
              graisse légère, pas par la transparence.
            */}
            {i > 0 && (
              <span aria-hidden="true" class="font-light text-navy/70">
                /
              </span>
            )}
            {dernier ? (
              <span aria-current="page" class="font-bold text-navy/75">
                {item.label}
              </span>
            ) : (
              <a
                href={item.href}
                class="-my-3 inline-flex min-h-11 items-center py-3 transition-colors duration-150 hover:text-orange focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange"
              >
                {item.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
