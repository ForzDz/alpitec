---
import { Image } from 'astro:assets';

/**
 * Galerie « Réalisations » — 3 à 4 photos de chantier.
 *
 * Les photos viennent de _sources/photos/{slug}/ via getServicePhotos().
 * Tant qu'un service n'a aucune photo, la section entière disparaît : mieux
 * vaut une section absente qu'une section creuse sur une page qui doit
 * inspirer confiance.
 *
 * Quand il y en a une ou deux, la grille est complétée par des tuiles navy
 * plutôt que par une image répétée — répéter la même photo dans une galerie
 * de « réalisations » se voit immédiatement et décrédibilise le reste.
 */

const { photos = [], title, shortLabel, ordre } = Astro.props;

// Grille de 3 quand on a 3 photos, de 4 sinon (1, 2 ou 4 photos).
const colonnes = photos.length === 3 ? 3 : 4;
const tuiles = Math.max(0, colonnes - photos.length);
---

{
  photos.length > 0 && (
    <section
      class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20"
      aria-labelledby="realisations"
      data-reveal
    >
      <h2
        id="realisations"
        class="border-l-2 border-orange pl-5 text-2xl font-bold leading-tight tracking-tight text-navy text-balance sm:text-3xl"
      >
        {title}
      </h2>

      <ul
        class:list={[
          'mt-9 grid gap-4 sm:gap-5 sm:grid-cols-2',
          colonnes === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4',
        ]}
      >
        {photos.map((photo) => (
          <li class="flex flex-col">
            <figure class="flex h-full flex-col">
              <div class="relative overflow-hidden bg-gris">
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  width={640}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 92vw"
                  format="webp"
                  quality={68}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] h-full w-full object-cover"
                />
                <span aria-hidden="true" class="absolute left-0 top-0 h-12 w-0.5 bg-orange" />
              </div>

              {photo.caption && (
                <figcaption class="mt-3 text-[0.8125rem] leading-snug text-navy/60 text-pretty">
                  {photo.caption}
                </figcaption>
              )}
            </figure>
          </li>
        ))}

        {/* Complément : tuiles navy, jamais une photo réutilisée. */}
        {Array.from({ length: tuiles }).map(() => (
          <li class="flex">
            <div
              class="flex aspect-[4/3] w-full flex-col justify-between bg-navy p-5"
              aria-hidden="true"
            >
              <span class="text-[0.625rem] font-bold tracking-[0.2em] text-orange">
                {String(ordre ?? 0).padStart(2, '0')}
              </span>
              <span class="max-w-[16ch] text-[0.9375rem] font-bold uppercase leading-tight tracking-[0.08em] text-blanc/85 text-balance">
                {shortLabel}
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
