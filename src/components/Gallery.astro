---
import { Image } from 'astro:assets';
import TitreSection from './TitreSection.astro';

/**
 * Galerie « Réalisations ».
 *
 * Les photos viennent de src/assets/photos/{slug}/ via getServicePhotos().
 * Tant qu'un service n'a aucune photo, la section entière disparaît : mieux
 * vaut une section absente qu'une section creuse sur une page qui doit
 * inspirer confiance.
 *
 * MISE EN PAGE — une photo de tête en pleine largeur, puis les autres en
 * grille. C'est la disposition de la bande de chantiers de l'accueil, et elle
 * a la même raison d'être : l'œil entre par une grande image, pas par une
 * rangée de vignettes égales.
 *
 * La précédente version faisait courir la première photo sur deux colonnes
 * d'une grille de quatre. À quatre photos — le cas de la plupart des pages
 * depuis l'arrivée des photos client — la quatrième se retrouvait seule sur
 * une deuxième rangée, avec trois cases vides à côté d'elle.
 *
 * Quand un service a moins de trois photos, la rangée du bas est complétée
 * par des tuiles navy plutôt que par une image répétée : répéter la même
 * photo dans une galerie de « réalisations » se voit immédiatement.
 */

const { photos = [], title, shortLabel, ordre } = Astro.props;

// Photo de tête : celle que le contenu désigne, sinon la première.
const enTete = photos.find((p) => p.miseEnAvant) ?? photos[0];
const reste = photos.filter((p) => p !== enTete);

// La grille du bas se cale sur son effectif pour ne jamais laisser de case
// vide en bout de rangée, et complète à deux items minimum par des tuiles.
const tuiles = photos.length > 0 && photos.length < 3 ? 2 - reste.length : 0;
const cases = reste.length + tuiles;

/*
 * Nombre de colonnes et rattrapage du dernier élément, de sorte qu'aucune
 * rangée ne se termine sur une case vide — ni sur mobile, ni sur grand écran.
 *
 *   effectif multiple de 3  →  trois colonnes ; si l'effectif est impair, le
 *                              dernier s'étale sur les deux colonnes du mobile
 *                              mais reprend sa case sur grand écran ;
 *   sinon                   →  deux colonnes ; si l'effectif est impair, le
 *                              dernier s'étale partout, y compris sur grand
 *                              écran, sinon il resterait seul sur sa rangée.
 *
 * Sept vignettes — le cas de « filets de protection » — tombent dans le second
 * cas : trois rangées de deux, puis une pleine largeur.
 */
const parTrois = cases % 3 === 0;
const impair = cases % 2 === 1;
const colonnes = parTrois ? 'lg:grid-cols-3' : 'lg:grid-cols-2';
const dernier = impair ? (parTrois ? 'col-span-2 lg:col-span-1' : 'col-span-2') : '';
---

{
  photos.length > 0 && (
    <section
      class="mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8"
      aria-labelledby="realisations"
    >
      <TitreSection texte={title} id="realisations" class="max-w-[18ch]" data-reveal="titre" />

      {/* Photo de tête, pleine largeur, 16/9. */}
      <figure class="mt-12" data-reveal="image">
        <div class="photo aspect-[16/9] w-full rounded-bloc shadow-repos">
          <Image
            src={enTete.src}
            alt={enTete.alt}
            width={1280}
            widths={[480, 768, 1280]}
            sizes="(min-width: 1280px) 1152px, 92vw"
            format="webp"
            quality={72}
            loading="lazy"
            decoding="async"
          />
        </div>
        {enTete.caption && (
          <figcaption class="mt-3.5 text-[0.8125rem] font-light leading-snug text-navy/70 text-pretty">
            {enTete.caption}
          </figcaption>
        )}
      </figure>

      {/* Les suivantes en 4/3. Deux ratios sur tout le site, pas un de plus. */}
      {cases > 0 && (
        <ul class:list={['mt-4 grid grid-cols-2 gap-4 sm:mt-5 sm:gap-5', colonnes]} data-reveal-groupe>
          {reste.map((photo, i) => (
            <li class:list={['flex flex-col', i === cases - 1 && dernier]}>
              <figure class="flex h-full flex-col">
                <div class="photo aspect-[4/3] rounded-bloc shadow-repos">
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    width={720}
                    widths={[320, 480, 720]}
                    sizes="(min-width: 1024px) 33vw, 46vw"
                    format="webp"
                    quality={70}
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                {photo.caption && (
                  <figcaption class="mt-3.5 text-[0.8125rem] font-light leading-snug text-navy/70 text-pretty">
                    {photo.caption}
                  </figcaption>
                )}
              </figure>
            </li>
          ))}

          {/* Complément : tuiles navy, jamais une photo réutilisée. */}
          {Array.from({ length: tuiles }).map(() => (
            <li class="flex">
              <div
                class="flex aspect-[4/3] w-full flex-col justify-between rounded-bloc bg-navy p-5 shadow-repos"
                aria-hidden="true"
              >
                <span class="font-display text-etiquette text-orange">
                  {String(ordre ?? 0).padStart(2, '0')}
                </span>
                <span class="max-w-[16ch] font-display text-[0.9375rem] font-bold uppercase leading-tight tracking-[0.08em] text-blanc/85 text-balance">
                  {shortLabel}
                </span>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}
