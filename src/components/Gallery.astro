---
import { Image } from 'astro:assets';
import TitreSection from './TitreSection.astro';

/**
 * Galerie « Réalisations » — 3 à 4 photos de chantier.
 *
 * Les photos viennent de _sources/photos/{slug}/ via getServicePhotos().
 * Tant qu'un service n'a aucune photo, la section entière disparaît : mieux
 * vaut une section absente qu'une section creuse sur une page qui doit
 * inspirer confiance.
 *
 * Quand il y en a une ou deux, la grille est complétée par des tuiles navy
 * plutôt que par une image répétée — répéter la même photo dans une galerie
 * de « réalisations » se voit immédiatement et décrédibilise le reste.
 */

const { photos = [], title, shortLabel, ordre } = Astro.props;

// Grille de 3 quand on a 3 photos, de 4 sinon (1, 2 ou 4 photos).
const colonnes = photos.length === 3 ? 3 : 4;
const tuiles = Math.max(0, colonnes - photos.length);
---

{
  photos.length > 0 && (
    <section
      class="mx-auto max-w-6xl px-5 py-[var(--espace-section)] sm:px-8"
      aria-labelledby="realisations"
      data-reveal
    >
      <TitreSection texte={title} id="realisations" class="max-w-[18ch]" />

      {/*
        La première photo occupe deux colonnes et un ratio 16/9 : l'œil entre
        par une grande image, pas par une rangée de vignettes égales. Les
        suivantes restent en 4/3. Deux ratios sur tout le site, pas un de plus.
      */}
      <ul
        class:list={[
          'mt-12 grid gap-4 sm:grid-cols-2 sm:gap-5',
          colonnes === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4',
        ]}
      >
        {photos.map((photo, i) => (
          <li class:list={['flex flex-col', i === 0 && 'sm:col-span-2']}>
            <figure class="flex h-full flex-col">
              <div
                class:list={[
                  'photo rounded-bloc shadow-repos',
                  i === 0 ? 'aspect-[16/9]' : 'aspect-[4/3]',
                ]}
              >
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  width={i === 0 ? 1280 : 640}
                  widths={i === 0 ? [480, 768, 1280] : [320, 480, 640]}
                  sizes={
                    i === 0
                      ? '(min-width: 1024px) 50vw, 92vw'
                      : '(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 92vw'
                  }
                  format="webp"
                  quality={70}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              {photo.caption && (
                <figcaption class="mt-3.5 text-[0.8125rem] font-light leading-snug text-navy/70 text-pretty">
                  {photo.caption}
                </figcaption>
              )}
            </figure>
          </li>
        ))}

        {/* Complément : tuiles navy, jamais une photo réutilisée. */}
        {Array.from({ length: tuiles }).map(() => (
          <li class="flex">
            <div
              class="flex aspect-[4/3] w-full flex-col justify-between rounded-bloc bg-navy p-5 shadow-repos"
              aria-hidden="true"
            >
              <span class="font-display text-etiquette text-orange">
                {String(ordre ?? 0).padStart(2, '0')}
              </span>
              <span class="max-w-[16ch] font-display text-[0.9375rem] font-bold uppercase leading-tight tracking-[0.08em] text-blanc/85 text-balance">
                {shortLabel}
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
