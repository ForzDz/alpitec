---
import { Image } from 'astro:assets';
import TitreSection from './TitreSection.astro';

/**
 * Galerie « Réalisations » — redesign premium.
 *
 * Layout :
 *   1 photo → pleine largeur 16/9 avec légende
 *   2 photos → split 60/40
 *   3+ photos → grande photo gauche + colonne droite empilée
 *
 * Les tuiles navy viennent compléter si < 3 photos totales pour éviter
 * une galerie à une seule image sans suite.
 */

const { photos = [], title, shortLabel, ordre } = Astro.props;

// Masquée si vide
if (photos.length === 0) return;

const enTete = photos.find((p) => p.miseEnAvant) ?? photos[0];
const reste = photos.filter((p) => p !== enTete);

// Tuiles de rembourrage si moins de 3 photos au total
const tuiles = photos.length < 3 ? Math.max(0, 2 - reste.length) : 0;
---

{photos.length > 0 && (
  <section class="gallery-section" aria-labelledby="realisations">
    <div class="gallery-section__inner">

      <div class="gallery-section__header">
        <div class="gallery-section__eyebrow">
          <span class="gallery-section__eyebrow-line" aria-hidden="true"></span>
          Nos réalisations
        </div>
        <TitreSection texte={title} id="realisations" class="gallery-section__title" data-reveal="titre" />
      </div>

      {/* Disposition principale */}
      {photos.length === 1 ? (
        /* ── 1 seule photo : pleine largeur ── */
        <figure class="gallery-solo" data-reveal="image">
          <div class="gallery-solo__img-wrap">
            <Image
              src={enTete.src}
              alt={enTete.alt}
              width={1280}
              widths={[480, 768, 1280]}
              sizes="(min-width: 1280px) 1152px, 92vw"
              format="webp"
              quality={72}
              loading="lazy"
              decoding="async"
              class="gallery-solo__img"
            />
          </div>
          {enTete.caption && (
            <figcaption class="gallery-caption">{enTete.caption}</figcaption>
          )}
        </figure>
      ) : (
        /* ── 2+ photos : grande gauche + grille droite ── */
        <div class="gallery-split" data-reveal-groupe>
          {/* Photo principale */}
          <figure class="gallery-split__main">
            <div class="gallery-split__main-img-wrap">
              <Image
                src={enTete.src}
                alt={enTete.alt}
                width={960}
                widths={[480, 768, 960]}
                sizes="(min-width: 1024px) 58vw, 92vw"
                format="webp"
                quality={72}
                loading="lazy"
                decoding="async"
                class="gallery-split__img"
              />
            </div>
            {enTete.caption && (
              <figcaption class="gallery-caption">{enTete.caption}</figcaption>
            )}
          </figure>

          {/* Colonne droite */}
          <div class="gallery-split__aside">
            {reste.map((photo) => (
              <figure class="gallery-split__thumb">
                <div class="gallery-split__thumb-img-wrap">
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    width={480}
                    widths={[240, 380, 480]}
                    sizes="(min-width: 1024px) 38vw, 92vw"
                    format="webp"
                    quality={70}
                    loading="lazy"
                    decoding="async"
                    class="gallery-split__img"
                  />
                </div>
                {photo.caption && (
                  <figcaption class="gallery-caption">{photo.caption}</figcaption>
                )}
              </figure>
            ))}

            {/* Tuiles navy de rembourrage */}
            {Array.from({ length: tuiles }).map(() => (
              <div class="gallery-tile" aria-hidden="true">
                <span class="gallery-tile__index">
                  {String(ordre ?? 0).padStart(2, '0')}
                </span>
                <span class="gallery-tile__label">{shortLabel}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}

<style>
/* ─── GALLERY SECTION ────────────────────────────────────────────────────────── */
.gallery-section {
  background: var(--color-blanc);
  padding: var(--espace-section) 0;
}

.gallery-section__inner {
  max-width: 72rem;
  margin: 0 auto;
  padding: 0 1.25rem;
}

@media (min-width: 640px) {
  .gallery-section__inner {
    padding: 0 2rem;
  }
}

.gallery-section__header {
  margin-bottom: 2.5rem;
}

.gallery-section__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 700;
  letter-spacing: var(--text-etiquette--letter-spacing);
  text-transform: uppercase;
  color: var(--color-navy);
  margin-bottom: 1rem;
}

.gallery-section__eyebrow-line {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--color-orange);
  border-radius: 1px;
}

.gallery-section__title {
  max-width: 22ch;
}

/* ─── Solo (1 photo) ───── */
.gallery-solo {
  margin: 0;
}

.gallery-solo__img-wrap {
  position: relative;
  aspect-ratio: 16/9;
  border-radius: var(--radius-bloc);
  overflow: hidden;
  background: var(--color-gris);
}

.gallery-solo__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 6s ease-out;
}

.gallery-solo__img-wrap:hover .gallery-solo__img {
  transform: scale(1.04);
}

/* ─── Split (2+ photos) ── */
.gallery-split {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
}

@media (min-width: 768px) {
  .gallery-split {
    grid-template-columns: 3fr 2fr;
    gap: 1rem;
  }
}

.gallery-split__main {
  margin: 0;
}

.gallery-split__main-img-wrap {
  position: relative;
  border-radius: var(--radius-bloc);
  overflow: hidden;
  background: var(--color-gris);
  height: 100%;
  min-height: 300px;
}

@media (min-width: 768px) {
  .gallery-split__main-img-wrap {
    min-height: 420px;
  }
}

.gallery-split__aside {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.gallery-split__thumb {
  margin: 0;
  flex: 1;
}

.gallery-split__thumb-img-wrap {
  position: relative;
  border-radius: var(--radius-bloc);
  overflow: hidden;
  background: var(--color-gris);
  height: 100%;
  min-height: 160px;
}

/* Image commune */
.gallery-split__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 6s ease-out;
}

.gallery-split__main-img-wrap:hover .gallery-split__img,
.gallery-split__thumb-img-wrap:hover .gallery-split__img {
  transform: scale(1.05);
}

/* ─── Tuile de rembourrage ── */
.gallery-tile {
  flex: 1;
  border-radius: var(--radius-bloc);
  background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-profond) 100%);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 140px;
  border: 1px solid color-mix(in srgb, var(--color-blanc) 6%, transparent);
}

.gallery-tile__index {
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 800;
  letter-spacing: var(--text-etiquette--letter-spacing);
  color: var(--color-orange);
}

.gallery-tile__label {
  font-family: var(--font-display);
  font-size: var(--text-petit);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: color-mix(in srgb, var(--color-blanc) 80%, transparent);
  text-wrap: balance;
  max-width: 16ch;
  line-height: 1.25;
  text-transform: uppercase;
}

/* ─── Légende ── */
.gallery-caption {
  margin-top: 0.625rem;
  font-family: var(--font-sans);
  font-size: var(--text-petit);
  font-weight: 300;
  line-height: 1.5;
  color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  text-wrap: pretty;
  font-style: italic;
}
</style>
