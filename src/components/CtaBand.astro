---
import Button from './Button.astro';
import { getSite, actionHref } from '../lib/content.js';

/**
 * CtaBand — Bandeau de conversion premium, style "Apple" avec animation douce.
 */

const { title, text, buttons = [], variant = 'navy', id } = Astro.props;
const site = await getSite();

const clair = variant !== 'gris';

// Split du titre pour l'accent sur le dernier mot
const mots = String(title).trim().split(/\s+/);
const dernierMot = mots.pop();
const debutTitre = mots.join(' ');
---

<section class={`ctaband ${clair ? 'ctaband--navy' : 'ctaband--gris'}`} id={id} data-reveal>
  {clair && (
    <div class="ctaband__bg" aria-hidden="true">
      <div class="ctaband__blob ctaband__blob--1"></div>
      <div class="ctaband__blob ctaband__blob--2"></div>
      <div class="ctaband__grid"></div>
    </div>
  )}

  <div class="ctaband__inner">

    {/* Eyebrow */}
    <div class={`ctaband__eyebrow ${clair ? 'ctaband__eyebrow--light' : ''}`}>
      <span class="ctaband__eyebrow-dot" aria-hidden="true"></span>
      Passer à l'action
    </div>

    {/* Titre */}
    <h2 class="ctaband__title">
      {debutTitre && <>{debutTitre} </>}
      <span class="ctaband__title-accent">{dernierMot}</span>
    </h2>

    {text && (
      <p class="ctaband__text">{text}</p>
    )}

    {buttons.length > 0 && (
      <div class="ctaband__ctas">
        {buttons.map((bouton, i) => (
          <a
            href={actionHref(bouton.action, site)}
            class={i === 0 ? 'ctaband-btn ctaband-btn--primary' : 'ctaband-btn ctaband-btn--ghost'}
          >
            {bouton.label}
            {i === 0 && (
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="ctaband-btn__arrow" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
          </a>
        ))}
      </div>
    )}

    {/* Trust strip */}
    <div class="ctaband__trust" aria-label="Garanties">
      {[
        { icon: '✓', text: 'Devis gratuit sous 24h' },
        { icon: '✓', text: 'Cordistes certifiés CQP & IRATA' },
        { icon: '✓', text: 'Garantie décennale incluse' },
      ].map(item => (
        <span class="ctaband__trust-item">
          <span class="ctaband__trust-check" aria-hidden="true">{item.icon}</span>
          {item.text}
        </span>
      ))}
    </div>

  </div>
</section>

<style>
/* ─── CtaBand ────────────────────────────────────────────────────────────────── */
.ctaband {
  position: relative;
  overflow: hidden;
}

.ctaband--navy {
  background: var(--color-navy-profond);
}

.ctaband--gris {
  background: var(--color-gris);
}

/* Background */
.ctaband__bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.ctaband__blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(70px);
}

.ctaband__blob--1 {
  width: 500px;
  height: 500px;
  left: -120px;
  top: -160px;
  background: radial-gradient(circle, color-mix(in srgb, var(--color-orange) 14%, transparent) 0%, transparent 70%);
}

.ctaband__blob--2 {
  width: 350px;
  height: 350px;
  right: -60px;
  bottom: -80px;
  background: radial-gradient(circle, color-mix(in srgb, var(--color-navy-clair) 12%, transparent) 0%, transparent 70%);
}

.ctaband__grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(color-mix(in srgb, var(--color-blanc) 2.5%, transparent) 1px, transparent 1px),
    linear-gradient(90deg, color-mix(in srgb, var(--color-blanc) 2.5%, transparent) 1px, transparent 1px);
  background-size: 48px 48px;
}

/* Inner */
.ctaband__inner {
  position: relative;
  max-width: 64rem;
  margin: 0 auto;
  padding: var(--espace-section) 1.25rem;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

@media (min-width: 640px) {
  .ctaband__inner {
    padding-left: 2rem;
    padding-right: 2rem;
    align-items: center;
    text-align: center;
  }
}

/* Eyebrow */
.ctaband__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 700;
  letter-spacing: var(--text-etiquette--letter-spacing);
  text-transform: uppercase;
  color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  margin-bottom: 1.25rem;
}

.ctaband__eyebrow--light {
  color: color-mix(in srgb, var(--color-blanc) 70%, transparent);
}

.ctaband__eyebrow-dot {
  display: block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--color-orange);
  box-shadow: 0 0 6px var(--color-orange);
  animation: pulse-dot 2.4s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.85); }
}

/* Title */
.ctaband__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4.5vw, 3.25rem);
  font-weight: 800;
  letter-spacing: -0.025em;
  line-height: 1.05;
  color: var(--color-blanc);
  max-width: 20ch;
  text-wrap: balance;
  margin-bottom: 1.25rem;
}

.ctaband--gris .ctaband__title {
  color: var(--color-navy);
}

.ctaband__title-accent {
  color: var(--color-orange);
}

.ctaband--gris .ctaband__title-accent {
  color: var(--color-orange-texte);
}

/* Text */
.ctaband__text {
  font-family: var(--font-sans);
  font-size: var(--text-corps);
  font-weight: 300;
  line-height: 1.7;
  color: color-mix(in srgb, var(--color-blanc) 70%, transparent);
  max-width: 52ch;
  text-wrap: pretty;
  margin-bottom: 2.25rem;
}

.ctaband--gris .ctaband__text {
  color: color-mix(in srgb, var(--color-navy) 70%, transparent);
}

/* CTAs */
.ctaband__ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 2rem;
}

.ctaband-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--text-petit);
  letter-spacing: -0.01em;
  border-radius: 9999px;
  padding: 0.875rem 1.75rem;
  transition: all 0.22s var(--sortie);
  text-decoration: none;
  white-space: nowrap;
}

.ctaband-btn--primary {
  background: var(--color-orange);
  color: var(--color-navy-profond);
  box-shadow: 0 4px 20px color-mix(in srgb, var(--color-orange) 40%, transparent);
}

.ctaband-btn--primary:hover {
  background: var(--color-blanc);
  color: var(--color-navy-profond);
  transform: translateY(-2px);
  box-shadow: 0 8px 32px color-mix(in srgb, var(--color-blanc) 20%, transparent);
}

.ctaband-btn__arrow {
  width: 14px;
  height: 14px;
  transition: transform 0.2s ease;
}

.ctaband-btn--primary:hover .ctaband-btn__arrow {
  transform: translateX(3px);
}

.ctaband-btn--ghost {
  background: color-mix(in srgb, var(--color-blanc) 6%, transparent);
  color: color-mix(in srgb, var(--color-blanc) 85%, transparent);
  border: 1px solid color-mix(in srgb, var(--color-blanc) 18%, transparent);
  backdrop-filter: blur(8px);
}

.ctaband-btn--ghost:hover {
  background: color-mix(in srgb, var(--color-blanc) 12%, transparent);
  border-color: color-mix(in srgb, var(--color-blanc) 30%, transparent);
  transform: translateY(-2px);
}

/* Trust strip */
.ctaband__trust {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  align-items: center;
}

.ctaband__trust-item {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-family: var(--font-display);
  font-size: var(--text-petit);
  font-weight: 600;
  color: color-mix(in srgb, var(--color-blanc) 70%, transparent);
}

.ctaband--gris .ctaband__trust-item {
  color: color-mix(in srgb, var(--color-navy) 70%, transparent);
}

.ctaband__trust-check {
  color: var(--color-orange);
  font-style: normal;
  font-size: var(--text-etiquette);
}
</style>
