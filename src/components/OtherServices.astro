---
import { getOtherServices, serviceHref } from '../lib/content.js';

/**
 * OtherServices — Grille des autres services, design premium horizontal scroll + masonry
 */

const { currentSlug, title = 'Nos autres services cordistes' } = Astro.props;
const autres = await getOtherServices(currentSlug);
---

<section class="other-services" aria-labelledby="autres-services-titre" data-reveal>
  <div class="other-services__inner">

    <div class="other-services__header">
      <div class="other-services__eyebrow">
        <span class="other-services__eyebrow-line" aria-hidden="true"></span>
        Aller plus loin
      </div>
      <h2 class="other-services__title" id="autres-services-titre">
        {title}
      </h2>
    </div>

    <ul class="other-services__grid" data-reveal-groupe>
      {autres.map((service, i) => (
        <li class="other-services__item">
          <a
            href={serviceHref(service.data.slug)}
            class="other-services__link"
          >
            {/* Index décoratif */}
            <span class="other-services__index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>

            {/* Contenu */}
            <span class="other-services__label">
              {service.data.shortLabel}
            </span>

            {/* Flèche */}
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="other-services__arrow"
              aria-hidden="true"
            >
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
.other-services {
  background: var(--color-gris);
  padding: var(--espace-section) 0;
}

.other-services__inner {
  max-width: 72rem;
  margin: 0 auto;
  padding: 0 1.25rem;
}

@media (min-width: 640px) {
  .other-services__inner {
    padding: 0 2rem;
  }
}

.other-services__header {
  margin-bottom: 2.5rem;
}

.other-services__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 700;
  letter-spacing: var(--text-etiquette--letter-spacing);
  text-transform: uppercase;
  color: var(--color-navy);
  margin-bottom: 1rem;
}

.other-services__eyebrow-line {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--color-orange);
  border-radius: 1px;
}

.other-services__title {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--color-navy);
  line-height: 1.1;
  text-wrap: balance;
  max-width: 22ch;
}

.other-services__grid {
  display: grid;
  gap: 0.5rem;
  list-style: none;
  padding: 0;
  margin: 0;
  grid-template-columns: 1fr;
}

@media (min-width: 640px) {
  .other-services__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .other-services__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.other-services__item {
  display: flex;
}

.other-services__link {
  display: flex;
  align-items: center;
  gap: 1rem;
  width: 100%;
  padding: 1.125rem 1.25rem;
  background: var(--color-blanc);
  border: 1px solid transparent;
  border-radius: var(--radius-carte);
  text-decoration: none;
  transition: all 0.2s var(--sortie);
  position: relative;
  overflow: hidden;
}

.other-services__link::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, color-mix(in srgb, var(--color-orange) 4%, transparent) 0%, transparent 60%);
  opacity: 0;
  transition: opacity 0.2s ease;
}

.other-services__link:hover {
  border-color: color-mix(in srgb, var(--color-orange) 25%, transparent);
  transform: translateY(-2px);
  box-shadow: 0 6px 24px color-mix(in srgb, var(--color-navy) 10%, transparent);
}

.other-services__link:hover::before {
  opacity: 1;
}

.other-services__index {
  font-family: var(--font-display);
  font-size: var(--text-etiquette);
  font-weight: 800;
  letter-spacing: 0.04em;
  color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  flex-shrink: 0;
  transition: color 0.2s ease;
}

.other-services__link:hover .other-services__index {
  color: var(--color-navy);
}

.other-services__label {
  font-family: var(--font-display);
  font-size: var(--text-petit);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--color-navy);
  line-height: 1.3;
  flex: 1;
  text-wrap: balance;
}

.other-services__arrow {
  width: 14px;
  height: 14px;
  color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  flex-shrink: 0;
  transition: color 0.2s ease, transform 0.2s ease;
}

.other-services__link:hover .other-services__arrow {
  color: var(--color-orange);
  transform: translateX(3px);
}
</style>
